function submitPositionLineupToDutyRegister_(ss, params) {
  const sheet = getDutyRegisterSheet_(ss);
  if (!sheet) return { status: "error", message: "Duty Register sheet not found." };
  const headers = getDutyRegisterHeaders_(sheet);
  const lineup = getPositionLineupSnapshot_(ss);
  if (!lineup.date || !lineup.items.length) return { status: "error", message: "Published Position Lineup or its date could not be read." };
  const row = findDutyRegisterRow_(sheet, lineup.date);
  if (row < 0) return { status: "error", message: "No Duty Register row exists for " + formatDisplayDate(lineup.date) + "." };

  const values = new Array(headers.length).fill("");
  const used = new Set();
  lineup.items.forEach(item => {
    const pos = item.position.toLowerCase().replace(/[^a-z0-9]/g, "");
    let candidates = [];
    if (pos.includes("machine")) candidates = headers.map((h, i) => ({ h: h, i })).filter(x => x.h.toLowerCase().replace(/[^a-z0-9]/g, "").includes("machine"));
    else if (pos.includes("reliever")) candidates = headers.map((h, i) => ({ h: h, i })).filter(x => x.h.toLowerCase().replace(/[^a-z0-9]/g, "").includes("reliever"));
    else candidates = headers.map((h, i) => ({ h: h, i })).filter(x => x.h.toLowerCase().replace(/[^a-z0-9]/g, "") === pos);
    let chosen = candidates.find(x => !used.has(x.i));
    if (!chosen || !item.operator) return;
    values[chosen.i] = item.operator;
    used.add(chosen.i);
  });

  const seenOperators = new Set();
  for (let i = 0; i < values.length; i++) {
    const value = String(values[i] || "").trim();
    if (!value || ["ot", "h", "m"].includes(value.toLowerCase())) continue;
    const key = value.toLowerCase();
    if (seenOperators.has(key)) return { status: "error", message: "The current Position Lineup assigns " + value + " to more than one position. Please correct the lineup before submitting." };
    seenOperators.add(key);
  }
  if (!values.some(v => String(v || "").trim())) return { status: "error", message: "The current Position Lineup has no operator assignments to submit." };

  const existing = sheet.getRange(row, 3, 1, headers.length).getDisplayValues()[0].map(v => String(v || "").trim());
  const occupied = existing.map((value, i) => value ? { position: headers[i], value: value } : null).filter(Boolean);
  if (occupied.length && String(params.overwrite || "") !== "1") {
    return { status: "confirm_required", message: "Duty Register already contains entries for " + formatDisplayDate(lineup.date) + ". Replace them with this lineup?", existing: occupied, date: lineup.date };
  }

  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return { status: "error", message: "Another duty update is in progress. Please try again." };
  try {
    const lockedExisting = sheet.getRange(row, 3, 1, headers.length).getDisplayValues()[0].map(v => String(v || "").trim());
    const lockedOccupied = lockedExisting.map((value, i) => value ? { position: headers[i], value: value } : null).filter(Boolean);
    if (lockedOccupied.length && String(params.overwrite || "") !== "1") {
      return { status: "confirm_required", message: "Duty Register already contains entries for " + formatDisplayDate(lineup.date) + ". Replace them with this lineup?", existing: lockedOccupied, date: lineup.date };
    }
    sheet.getRange(row, 3, 1, headers.length).setValues([values]);
    try { CacheService.getScriptCache().remove("r3_dashboard_cache"); } catch (e) {}
  } finally { lock.releaseLock(); }
  return { status: "success", message: "Position Lineup assignments added to Duty Register.", date: lineup.date, dateText: formatDisplayDate(lineup.date) };
}

function getDutyByDate(ss, targetDateStr) {
  let sheet = getSheetFuzzy(ss, "Duty Register") || getSheetFuzzy(ss, "DUTY REGISTER") || getSheetFuzzy(ss, "Duty");
  if (!sheet) {
    const sheets = ss.getSheets();
    for (let s of sheets) {
      if (s.getName().toLowerCase().includes("duty") || s.getName().toLowerCase().includes("register")) {
        sheet = s;
        break;
      }
    }
  }
  if (!sheet) sheet = ss.getSheets()[0];

  const data = sheet.getDataRange().getValues();
  if (data.length < 2) return { status: "success", date: targetDateStr, day: "-", dutyRows: [] };

  const headers = data[0]; 
  let resultRows = [];
  let dayVal = "-";
  
  const normTarget = normalizeDateStr(targetDateStr);
  const cleanTargetCompact = normTarget.replace(/-/g, "");

  let targetRowIndex = -1;
  let assignments = {};

  for (let i = 1; i < data.length; i++) {
    const rowDate = data[i][0];
    if (!rowDate) continue;
    const formattedDate = normalizeDateStr(rowDate);
    const compactRowDate = formattedDate.replace(/-/g, "");
    const rawDateStr = rowDate.toString().trim();

    if (compactRowDate === cleanTargetCompact || formattedDate === normTarget || rawDateStr.includes(targetDateStr) || rawDateStr.includes(targetDateStr.replace(/-/g, '/'))) {
      targetRowIndex = i;
      dayVal = (data[i][1] || "-").toString().trim();
      for (let j = 2; j < headers.length; j++) {
        const posName = (headers[j] || "").toString().trim();
        const opName = (data[i][j] || "").toString().trim();
        const posLower = posName.toLowerCase();
        if (posName && !posLower.includes("gmt") && !posLower.includes("standard time") && !posLower.includes("thu ") && !posLower.includes("fri ") && !posLower.includes("sat ") && !posLower.includes("sun ") && !posLower.includes("mon ") && !posLower.includes("tue ") && !posLower.includes("wed ")) {
          assignments[posName] = opName;
        }
      }
      break;
    }
  }

  function getColsForPosition(posName) {
    let cols = [];
    let clean = posName.toLowerCase().replace(/[^a-z0-9]/g, "");
    for (let j = 2; j < headers.length; j++) {
      let h = (headers[j] || "").toString().trim().toLowerCase().replace(/[^a-z0-9]/g, "");
      if (clean.includes("reliever") && h.includes("reliever")) {
        cols.push(j);
      } else if (clean.includes("machine") && h.includes("machine")) {
        cols.push(j);
      } else if (h === clean) {
        cols.push(j);
      }
    }
    if (cols.length === 0) {
      for (let j = 2; j < headers.length; j++) {
        if ((headers[j] || "").toString().trim().toLowerCase() === posName.toLowerCase()) {
          cols.push(j);
          break;
        }
      }
    }
    return cols;
  }

  let targetDateObj = new Date(normTarget + "T00:00:00");

  for (let pos in assignments) {
    let op = assignments[pos];
    let lastDate = "-";
    let due = "-";

    if (op && op !== "-" && !isNaN(targetDateObj.getTime())) {
      let searchCols = getColsForPosition(pos);

      if (searchCols.length > 0 && targetRowIndex !== -1) {
        let bestPrevDateObj = null;
        let bestPrevDateStr = "-";

        for (let i = targetRowIndex - 1; i >= 1; i--) {
          let rowDateVal = data[i][0];
          let rowDateObj = new Date(normalizeDateStr(rowDateVal) + "T00:00:00");
          if (isNaN(rowDateObj.getTime())) continue;

          for (let c = 0; c < searchCols.length; c++) {
            let prevOp = (data[i][searchCols[c]] || "").toString().trim();
            if (prevOp.toLowerCase() === op.toLowerCase()) {
              if (!bestPrevDateObj || rowDateObj.getTime() > bestPrevDateObj.getTime()) {
                bestPrevDateObj = rowDateObj;
                bestPrevDateStr = formatDisplayDate(normalizeDateStr(rowDateVal));
              }
            }
          }
        }

        if (bestPrevDateObj) {
          lastDate = bestPrevDateStr;
          let diffTime = targetDateObj.getTime() - bestPrevDateObj.getTime();
          due = Math.round(diffTime / (1000 * 60 * 60 * 24));
        }
      }
    }

    resultRows.push({
      position: pos,
      operator: op || "-",
      due: due,
      lastDate: lastDate
    });
  }

  return {
    status: "success",
    date: formatDisplayDate(normTarget),
    day: dayVal,
    dutyRows: resultRows
  };
}

