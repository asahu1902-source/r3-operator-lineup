    });
  }

  let warningA1 = "⚠️ Duty Allocation in Progress — Please Check Back Later";
  let warningA2 = "🚨 CURRENTLY DUTY PORTAL SERVER DOWN, PLEASE CHECK LATER 🚨";
  let warnSheet = getSheetFuzzy(ss, "Warning") || getSheetFuzzy(ss, "Wanning");
  if (warnSheet) {
    let valA1 = warnSheet.getRange("A1").getDisplayValue().trim();
    let valA2 = warnSheet.getRange("A2").getDisplayValue().trim();
    if (valA1) warningA1 = valA1;
    if (valA2) warningA2 = valA2;
  }

  const lineupSheet = getSheetFuzzy(ss, "POSITION LINEUP");
  let lineupStatus = "Published";
  
  if (lineupSheet) {
    let g1Val = lineupSheet.getRange("G1").getDisplayValue().trim();
    if (g1Val.toLowerCase().includes("deactive")) {
      lineupStatus = "maintenance";
    }
  }

  let dateBanner = "11/09/2026 - Friday", rows = [], standBy = "-", offDay = "-", leave = "-", info = "-", availableCount = "0";

  if (lineupSheet && lineupStatus !== "maintenance") {
    let c3Val = lineupSheet.getRange("C3").getDisplayValue() || lineupSheet.getRange("C1").getDisplayValue() || "Published";
    lineupStatus = c3Val.trim();

    let rawBanner = lineupSheet.getRange("C7").getDisplayValue() || lineupSheet.getRange("C8").getDisplayValue() || "Lineup";
    let bannerDateOnly = rawBanner.split('-')[0].trim();
    let normBDate = normalizeDateStr(bannerDateOnly);

    let schedSheet = getSheetFuzzy(ss, "Shift Schedule");
    if (schedSheet && normBDate) {
      const sVals = schedSheet.getRange(2, 1, schedSheet.getLastRow() - 1, 5).getValues();
      for (let i = 0; i < sVals.length; i++) {
        if (normalizeDateStr(sVals[i][0]) === normBDate) {
          let dayName = (sVals[i][1] || "").toString().trim();
          let r3Val = (sVals[i][2] || "-").toString().trim();
          dateBanner = `${bannerDateOnly} - ${dayName} | R3 Shift: ${r3Val}`;
          break;
        }
      }
    }
    if (!dateBanner.includes("R3 Shift")) {
      dateBanner = rawBanner;
    }

    if (lineupStatus.toLowerCase() === "published") {
      const dutyValues = lineupSheet.getRange(10, 3, 9, 6).getDisplayValues();
      dutyValues.forEach(r => {
        if (r[0] && r[0].trim()) {
          rows.push({ pos: r[0].trim(), duty: `${r[1] ? r[1].trim() : "-"} - ${r[2] ? r[2].trim() : "-"} - ${r[3] ? r[3].trim() : "-"} - ${r[4] ? r[4].trim() : "-"} - ${r[5] ? r[5].trim() : "-"}` });
        }
      });

      availableCount = lineupSheet.getRange("D19").getDisplayValue() || "0";
      standBy = lineupSheet.getRange("F19").getDisplayValue() || lineupSheet.getRange("G19").getDisplayValue() || lineupSheet.getRange("H19").getDisplayValue() || "-";
      offDay = lineupSheet.getRange("D20").getDisplayValue() || "None";
      leave = lineupSheet.getRange("D21").getDisplayValue() || "None";
      info = lineupSheet.getRange("D22").getDisplayValue() || "-";
    }
  }

  let dueMatrix = {};
  const sumSheet = getSheetFuzzy(ss, "SUMMARY2");
  if (sumSheet) {
    const headers = ["DE-STACKER", "ACB", "C-OFF", "LEFT SIDE", "MACHINE", "CCB", "RELIEVER"];
    const dueVals = sumSheet.getRange("A2:H11").getDisplayValues();
    const dateVals = sumSheet.getRange("A16:H25").getDisplayValues();
    const shiftVals = sumSheet.getRange("A29:H38").getDisplayValues();
    const daysOfWeek = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    dueVals.forEach((row, idx) => {
      const opName = (row[0] || "").trim();
      if (opName && opName.toLowerCase() !== "operator") {
        const cleanKey = opName.toLowerCase();
        const records = headers.map((pos, cIdx) => {
          const rawDate = (dateVals[idx] && dateVals[idx][cIdx + 1]) ? dateVals[idx][cIdx + 1].trim() : "-";
          let dayName = "-";
          if (rawDate && rawDate !== "-") {
            const norm = normalizeDateStr(rawDate);
            const p = norm.split('-');
            if (p.length === 3) {
              const dtObj = new Date(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10));
              if (!isNaN(dtObj.getTime())) dayName = daysOfWeek[dtObj.getDay()];
            }
          }

          return {
            pos: pos,
            due: (row[cIdx + 1] !== undefined && row[cIdx + 1] !== "") ? row[cIdx + 1] : "0",
            lastDate: formatDisplayDate(normalizeDateStr(rawDate)) || rawDate,
            lastDay: dayName,
            lastShift: (shiftVals[idx] && shiftVals[idx][cIdx + 1]) ? shiftVals[idx][cIdx + 1] : "-"
          };
        });

        dueMatrix[cleanKey] = records;
        dueMatrix[opName] = records;
      }
    });
  }

  const schedSheet = getSheetFuzzy(ss, "Shift Schedule");
  let scheduleFastLookup = {};
  if (schedSheet && schedSheet.getLastRow() >= 2) {
    const totalRows = Math.min(schedSheet.getLastRow(), 3000);
    const allSched = schedSheet.getRange(2, 1, totalRows - 1, 5).getValues();
    allSched.forEach(r => {
      const normDate = normalizeDateStr(r[0]);
      if (normDate) {
        scheduleFastLookup[normDate] = {
          day: (r[1] || "").toString().trim(),
          r3: (r[2] || "-").toString().trim(),
          r2: (r[3] || "-").toString().trim(),
          r1: (r[4] || "-").toString().trim()
        };
      }
    });
  }

  const holSheet = getSheetFuzzy(ss, "Holiday_List");
  let holidays = [];
  if (holSheet && holSheet.getLastRow() >= 2) {
    const totalHols = holSheet.getLastRow() - 1;
    const hData = holSheet.getRange(2, 1, totalHols, 3).getValues();
    hData.forEach(r => {
      const rawDate = r[0];
      const holName = (r[2] || "").toString().trim();
      if (rawDate && holName) {
        const normDate = normalizeDateStr(rawDate);
        const match = scheduleFastLookup[normDate] || { day: (r[1] || "").toString().trim(), r3: "-", r2: "-", r1: "-" };

        holidays.push({
          rawDate: formatDisplayDate(normDate),
          date: normDate,
          day: match.day || (r[1] || "").toString().trim(),
          name: holName,
          r3: match.r3,
          r2: match.r2,
          r1: match.r1
        });
      }
    });
  }

  const localFestivals = fetchLocalFestivals(ss, scheduleFastLookup);

  const finalResult = {
    status: "success",
    lineupStatus: lineupStatus,
    warningTexts: { a1: warningA1, a2: warningA2 },
    security: rules.sec,
    guestSecurity: rules.guestSec,
    supervisorMessages: supervisorMsgs,
    operators: operators,
    board: {
      dateBanner: dateBanner,
      rows: rows,
      availableCount: availableCount,
      standBy: standBy,
      offDay: offDay,
      leave: leave,
      info: info
    },
    dueMatrix: dueMatrix,
    holidays: holidays,
    localFestivals: localFestivals,
    scheduleLookup: scheduleFastLookup
  };

  applyAutoDutyPublishedSnapshot_(ss, finalResult);

  try {
    cache.put("r3_dashboard_cache", JSON.stringify(finalResult), 180);
  } catch (e) {}

  return finalResult;
}

