function handleLeaveSubmission(ss, params) {
  let leaveSheet = getSheetFuzzy(ss, "App_Leave");
  if (!leaveSheet) {
    leaveSheet = ss.insertSheet("App_Leave");
    leaveSheet.appendRow(["Timestamp", "Name", "Type", "From Date", "To Date", "Days", "Reason", "Status"]);
  }

  const timestamp = Utilities.formatDate(new Date(), "Asia/Kolkata", "dd/MM/yyyy HH:mm:ss");
  const name = params.name || "-";
  const type = (params.type || "-").trim().toLowerCase();
  const fromDate = params.fromDate || "-";
  const toDate = params.toDate || "-";
  const reason = params.reason || "-";
  const status = "Pending";

  let days = 1;
  if (fromDate && toDate && fromDate !== "-" && toDate !== "-") {
    const d1 = new Date(normalizeDateStr(fromDate) + "T00:00:00");
    const d2 = new Date(normalizeDateStr(toDate) + "T00:00:00");
    if (!isNaN(d1.getTime()) && !isNaN(d2.getTime())) {
      const diffTime = d2.getTime() - d1.getTime();
      const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));
      days = diffDays >= 0 ? diffDays + 1 : 1;
    }
  }

  let balRes = fetchOperatorLeaveBalance(ss, name);
  let bal = balRes.balance;
  let currentBal = 0;
  if (type.includes("pl")) currentBal = bal.pl;
  else if (type.includes("sl")) currentBal = bal.sl;
  else if (type.includes("cl")) currentBal = bal.cl;
  else if (type.includes("c/off") || type.includes("coff")) currentBal = bal.coff;

  if (currentBal > 0 && days > currentBal) {
    return { status: "error", message: `Insufficient leave balance! You have only ${currentBal} days remaining for this leave type.` };
  }

  leaveSheet.appendRow([timestamp, name, params.type, fromDate, toDate, days, reason, status]);

  if (SUPERVISOR_EMAIL) {
    try {
      MailApp.sendEmail(
        SUPERVISOR_EMAIL,
        `📢 Leave Application: ${name} (${params.type}) - Pending Approval`,
        `Operator: ${name}\nLeave Type: ${params.type}\nPeriod: ${fromDate} to ${toDate} (${days} Days)\nReason: ${reason}\nStatus: Pending\nSubmitted At: ${timestamp}`
      );
    } catch (e) {}
  }

  const contacts = getWhatsAppContacts(ss);
  return { status: "success", message: "Leave Recorded.", contacts: contacts };
}

