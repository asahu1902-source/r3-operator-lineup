          const name = sheet.getRange(row, 2).getDisplayValue().trim();
          const type = sheet.getRange(row, 3).getDisplayValue().trim();
          const days = parseFloat(sheet.getRange(row, 6).getDisplayValue()) || 1;
          checkAndAutoDeductLeaveBalance(sheet.getParent(), name, type, days);
