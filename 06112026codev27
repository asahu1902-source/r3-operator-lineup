  return { status: "success", message: "Leave withdrawn successfully." };
}

function fetchMonthlyReport(ss, params) {
  const opName = (params.name || "").trim().toLowerCase();
  const fromStr = (params.fromDate || "").trim();
  const toStr = (params.toDate || "").trim();

  let fromDate = fromStr ? new Date(normalizeDateStr(fromStr) + "T00:00:00") : new Date(2026, 0, 1);
  let toDate = toStr ? new Date(normalizeDateStr(toStr) + "T23:59:59") : new Date(2026, 11, 31);

  let myOffDayName = "";
  const offMasterSheet = getSheetFuzzy(ss, "Off Day Master");
  if (offMasterSheet && offMasterSheet.getLastRow() >= 23) {
    const masterData = offMasterSheet.getRange(23, 1, 10, 2).getValues();
    for (let i = 0; i < masterData.length; i++) {
      const nameInMaster = (masterData[i][0] || "").toString().trim().toLowerCase();
      if (nameInMaster === opName) {
        myOffDayName = (masterData[i][1] || "").toString().trim().toLowerCase();
        break;
      }
    }
  }

  const daysOfWeek = ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"];
  const regSheet = getSheetFuzzy(ss, "Duty Register");
  const posList = [
    { name: "De-stacker", colIdx: 2 },
    { name: "ACB", colIdx: 3 },
    { name: "C-Off", colIdx: 4 },
    { name: "Left Side", colIdx: 5 },
    { name: "Machine1", colIdx: 6 },
    { name: "Machine2", colIdx: 7 },
    { name: "CCB", colIdx: 8 },
    { name: "Reliever1", colIdx: 9 },
    { name: "Reliever2", colIdx: 10 },
    { name: "Standby Duty", colIdx: 11 }
  ];

  let positionalDuty = 0;
  let weeklyOffCount = 0;
  let maintenanceDays = 0;
  let otDates = [];
  let posStats = {};
  posList.forEach(p => posStats[p.name] = { count: 0, dates: [] });

  if (regSheet && regSheet.getLastRow() >= 2) {
    const regData = regSheet.getRange(2, 1, regSheet.getLastRow() - 1, 12).getValues();
    for (let i = 0; i < regData.length; i++) {
      const row = regData[i];
      const normRDate = normalizeDateStr(row[0]);
      if (!normRDate) continue;
      const rDate = new Date(normRDate + "T00:00:00");
      if (isNaN(rDate.getTime()) || rDate < fromDate || rDate > toDate) continue;

      const colCVal = (row[2] || "").toString().trim();
      if (!colCVal) continue;

      const dName = daysOfWeek[rDate.getDay()];
      const dateFormatted = formatDisplayDate(normRDate);

      if (myOffDayName && dName === myOffDayName) {
        weeklyOffCount++;
      }

      let rowHasDuty = false;
      let hasM = false;

      for (let c = 2; c <= 11; c++) {
        const val = (row[c] || "").toString().trim();
        if (val.toLowerCase() === opName) {
          rowHasDuty = true;
          const matchedPos = posList.find(p => p.colIdx === c);
          if (matchedPos) {
            posStats[matchedPos.name].count++;
            posStats[matchedPos.name].dates.push(dateFormatted);
          }
        }
        if (val.toUpperCase() === "M") hasM = true;
      }

      if (rowHasDuty) positionalDuty++;
      if (hasM && myOffDayName && dName !== myOffDayName) {
        maintenanceDays++;
      }

      const jVal = (row[9] || "").toString().trim().toUpperCase();
      if (jVal === "OT" || jVal === "") {
        otDates.push(dateFormatted);
      }
    }
  }

  let leaveDays = 0;
  let leaveDates = [];
  const leaveSheet = getSheetFuzzy(ss, "Leave Register");
  if (leaveSheet && leaveSheet.getLastRow() >= 2) {
    const lData = leaveSheet.getRange(2, 1, leaveSheet.getLastRow() - 1, 11).getValues();
    for (let i = 0; i < lData.length; i++) {
      const normLDate = normalizeDateStr(lData[i][0]);
      if (!normLDate) continue;
      const lDate = new Date(normLDate + "T00:00:00");
      if (isNaN(lDate.getTime()) || lDate < fromDate || lDate > toDate) continue;

      let matched = false;
      for (let c = 1; c <= 10; c++) {
        if ((lData[i][c] || "").toString().trim().toLowerCase() === opName) {
          matched = true;
          break;
        }
      }
      if (matched) {
        leaveDays++;
        leaveDates.push(formatDisplayDate(normLDate));
      }
    }
  }

  let offDayChanged = 0;
  const offChangeSheet = getSheetFuzzy(ss, "Off Day Change");
  if (offChangeSheet && offChangeSheet.getLastRow() >= 2) {
    const cData = offChangeSheet.getRange(2, 1, offChangeSheet.getLastRow() - 1, 3).getValues();
    for (let i = 0; i < cData.length; i++) {
      const normCDate = normalizeDateStr(cData[i][0]);
      if (!normCDate) continue;
      const cDate = new Date(normCDate + "T00:00:00");
      if (isNaN(cDate.getTime()) || cDate < fromDate || cDate > toDate) continue;
      const nm = (cData[i][1] || "").toString().trim().toLowerCase();
      const status = (cData[i][2] || "").toString().trim().toUpperCase();
      if (nm === opName && status === "OFF") {
        offDayChanged++;
      }
    }
  }

  let holidayCount = 0;
  const holSheet = getSheetFuzzy(ss, "Holiday_List");
  if (holSheet && holSheet.getLastRow() >= 2) {
    const hData = holSheet.getRange(2, 1, holSheet.getLastRow() - 1, 1).getValues();
    for (let i = 0; i < hData.length; i++) {
      const normHDate = normalizeDateStr(hData[i][0]);
      if (!normHDate) continue;
      const hDate = new Date(normHDate + "T00:00:00");
      if (!isNaN(hDate.getTime()) && hDate >= fromDate && hDate <= toDate) {
        holidayCount++;
      }
    }
  }

  const attendance = [
    { label: "Positional Duty", val: positionalDuty },
    { label: "Weekly Off", val: weeklyOffCount },
    { label: "Leave Days", val: leaveDays },
    { label: "Off Day Changed", val: offDayChanged },
    { label: "Holiday", val: holidayCount },
    { label: "OT", val: otDates.length },
    { label: "Maintenance Day", val: maintenanceDays }
  ];

  const performance = posList.map(p => {
    const count = posStats[p.name].count;
    const alloc = positionalDuty > 0 ? ((count / positionalDuty) * 100).toFixed(2) + "%" : "0.00%";
    return {
      position: p.name,
      timesWorked: count,
      allocation: alloc,
      dates: posStats[p.name].dates
    };
  });

  return {
    status: "success",
    attendance: attendance,
    performance: performance,
    leaveDates: leaveDates,
    otDates: otDates
  };
}

