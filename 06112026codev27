}

function handleWithdrawLeave(ss, rowIndex) {
  let leaveSheet = getSheetFuzzy(ss, "App_Leave");
  if (!leaveSheet) return { status: "error", message: "App_Leave sheet missing" };

  const row = parseInt(rowIndex, 10);
  if (isNaN(row) || row < 2) return { status: "error", message: "Invalid row index" };

