function getLatestDuty_(ss) {
  const lineupSheet = getSheetFuzzy(ss, "POSITION LINEUP");
  if (!lineupSheet) {
    return { status: "error", message: "POSITION LINEUP sheet not found." };
  }

  let lineupStatus = (lineupSheet.getRange("C3").getDisplayValue() || lineupSheet.getRange("C1").getDisplayValue() || "Published").trim();
  const g1 = (lineupSheet.getRange("G1").getDisplayValue() || "").trim().toLowerCase();
  if (g1.includes("deactive")) lineupStatus = "maintenance";

  let dateBanner = (lineupSheet.getRange("C7").getDisplayValue() || lineupSheet.getRange("C8").getDisplayValue() || "Lineup").trim();
  let rows = [];
  let availableCount = lineupSheet.getRange("D19").getDisplayValue() || "0";
  let standBy = lineupSheet.getRange("F19").getDisplayValue() || lineupSheet.getRange("G19").getDisplayValue() || lineupSheet.getRange("H19").getDisplayValue() || "-";
  let offDay = lineupSheet.getRange("D20").getDisplayValue() || "None";
  let leave = lineupSheet.getRange("D21").getDisplayValue() || "None";
  let info = lineupSheet.getRange("D22").getDisplayValue() || "-";

  if (lineupStatus.toLowerCase() === "published") {
    const rawBanner = dateBanner;
    const bannerDateOnly = rawBanner.split("-")[0].trim();
    const normBDate = normalizeDateStr(bannerDateOnly);
    const schedSheet = getSheetFuzzy(ss, "Shift Schedule");

    if (schedSheet && normBDate && schedSheet.getLastRow() >= 2) {
      const sVals = schedSheet.getRange(2, 1, schedSheet.getLastRow() - 1, 5).getValues();
      for (let i = 0; i < sVals.length; i++) {
        if (normalizeDateStr(sVals[i][0]) === normBDate) {
          const dayName = (sVals[i][1] || "").toString().trim();
          const r3Val = (sVals[i][2] || "-").toString().trim();
          dateBanner = `${bannerDateOnly} - ${dayName} | R3 Shift: ${r3Val}`;
          break;
        }
      }
    }

    const dutyValues = lineupSheet.getRange(10, 3, 9, 6).getDisplayValues();
    dutyValues.forEach(function(r) {
      if (r[0] && r[0].trim()) {
        rows.push({
          pos: r[0].trim(),
          duty: `${r[1] ? r[1].trim() : "-"} - ${r[2] ? r[2].trim() : "-"} - ${r[3] ? r[3].trim() : "-"} - ${r[4] ? r[4].trim() : "-"} - ${r[5] ? r[5].trim() : "-"}`
        });
      }
    });
  }

  const board = { dateBanner, rows, availableCount, standBy, offDay, leave, info };
  const response = applyAutoDutyPublishedSnapshot_(ss, { status: "success", lineupStatus: lineupStatus, board: board });
  lineupStatus = response.lineupStatus;
  dateBanner = response.board.dateBanner;
  rows = response.board.rows;
  availableCount = response.board.availableCount;
  standBy = response.board.standBy;
  offDay = response.board.offDay;
  leave = response.board.leave;
  info = response.board.info;
  const finalBoard = response.board;
  let signature = "";
  try { signature = Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, JSON.stringify({ lineupStatus, board: finalBoard }))); } catch (e) { signature = JSON.stringify({ lineupStatus, board: finalBoard }); }

  return { status: "success", lineupStatus, board: finalBoard, signature, autoDutyAdvancePublished: !!response.autoDutyAdvancePublished };
}

function normalizeDateStr(raw) {
  if (!raw) return "";
  if (raw instanceof Date) {
    if (isNaN(raw.getTime())) return "";
    return Utilities.formatDate(raw, "Asia/Kolkata", "yyyy-MM-dd");
  }
  const str = raw.toString().trim();
  if (!str) return "";

  const isoMatch = str.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (isoMatch) return str;

  const dmyMatch = str.match(/^(\d{1,2})[/-](\d{1,2})[/-](\d{2,4})$/);
  if (dmyMatch) {
    let d = padZero(dmyMatch[1]);
    let m = padZero(dmyMatch[2]);
    let y = dmyMatch[3];
    if (y.length === 2) y = "20" + y;
    return `${y}-${m}-${d}`;
  }

  const parsed = new Date(str);
  if (!isNaN(parsed.getTime())) {
    return Utilities.formatDate(parsed, "Asia/Kolkata", "yyyy-MM-dd");
  }
  return str;
}

function formatDisplayDate(isoStr) {
  if (!isoStr || !isoStr.includes("-")) return isoStr;
  const p = isoStr.split("-");
  if (p.length === 3) return `${p[2]}/${p[1]}/${p[0]}`;
  return isoStr;
}

function padZero(n) {
  return parseInt(n, 10) < 10 ? "0" + parseInt(n, 10) : "" + parseInt(n, 10);
}

function getSheetFuzzy(ss, target) {
  const sheets = ss.getSheets();
  const cleanTarget = target.toLowerCase().replace(/[^a-z0-9]/g, "");
  for (let i = 0; i < sheets.length; i++) {
    const name = sheets[i].getName().toLowerCase().replace(/[^a-z0-9]/g, "");
    if (name.indexOf(cleanTarget) !== -1) return sheets[i];
  }
  return null;
}

function getTargetColumn(posName) {
  const clean = (posName || "").toLowerCase().replace(/[^a-z0-9]/g, "");
  if (clean.includes("destacker")) return 3;
  if (clean.includes("acb")) return 4;
  if (clean.includes("coff") || clean.includes("c-off")) return 5;
  if (clean.includes("leftside")) return 6;
  if (clean.includes("machine2")) return 8;
  if (clean.includes("machine")) return 7;
  if (clean.includes("ccb")) return 9;
  if (clean.includes("reliever2")) return 11;
  if (clean.includes("reliever")) return 10;
  if (clean.includes("standby")) return 12;
  return 3;
}

