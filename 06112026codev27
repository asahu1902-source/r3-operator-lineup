function onEdit(e) {
  try {
    const sheet = e.range.getSheet();
    if (sheet.getName().toLowerCase().includes("app_leave") || sheet.getName().toLowerCase().includes("appleave")) {
      const row = e.range.getRow();
      const col = e.range.getColumn();
