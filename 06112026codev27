function getPositionLineupSnapshot_(ss) {
  const sheet = getSheetFuzzy(ss, "POSITION LINEUP");
  if (!sheet) return { date: "", items: [] };
  const banner = String(sheet.getRange("C7").getDisplayValue() || sheet.getRange("C8").getDisplayValue() || "").trim();
  const dateMatch = banner.match(/(\d{1,2}[\/-]\d{1,2}[\/-]\d{4})/);
  const date = dateMatch ? normalizeDateStr(dateMatch[1]) : "";
  const values = sheet.getRange(10, 3, 9, 2).getDisplayValues();
  const items = values.map(r => {
    const position = String(r[0] || "").trim();
    const raw = String(r[1] || "").trim();
    const operatorPart = raw ? raw.split(/\s+-\s+/)[0].trim() : "";
    const operator = ["-", "—"].includes(operatorPart) ? "" : operatorPart;
    return { position: position, operator: operator };
  }).filter(x => x.position);
  return { date: date, banner: banner, items: items };
}

