function readAutoDutyConfig_() {
  const props = PropertiesService.getScriptProperties();
  let saved = {};
  try { saved = JSON.parse(props.getProperty(R3_AUTO_DUTY_CONFIG_KEY_) || "{}"); } catch (e) {}
  const legacyDelay = saved.delaySeconds == null ? 5 : saved.delaySeconds;
  const legacyPublish = saved.publishSeconds == null ? 60 : saved.publishSeconds;
  const modeSettings = {};
  ["1", "2", "3"].forEach(mode => {
    const modeSaved = saved.modeSettings && saved.modeSettings[mode] || {};
    modeSettings[mode] = {
      delaySeconds: Math.max(0, Math.min(86400, Number(modeSaved.delaySeconds == null ? legacyDelay : modeSaved.delaySeconds) || 0)),
      publishSeconds: Math.max(0, Math.min(86400, Number(modeSaved.publishSeconds == null ? legacyPublish : modeSaved.publishSeconds) || 0)),
      sourceSheet: R3_AUTO_DUTY_SOURCES_.includes(String(modeSaved.sourceSheet || "")) ? String(modeSaved.sourceSheet) : (mode === "1" ? "POSITION LINEUP" : R3_AUTO_DUTY_ADVANCE_SHEET_)
    };
  });
  return {
    activeMode: ["1", "2", "3"].includes(String(saved.activeMode || "")) ? String(saved.activeMode) : "",
    modeSettings: modeSettings,
    shiftTimes: {
      A: String(saved.shiftTimes && saved.shiftTimes.A || "06:00"),
      B: String(saved.shiftTimes && saved.shiftTimes.B || "14:00"),
      C: String(saved.shiftTimes && saved.shiftTimes.C || "05:00")
    }
  };
}

function readAutoDutyProcess_() {
  try { return JSON.parse(PropertiesService.getScriptProperties().getProperty(R3_AUTO_DUTY_PROCESS_KEY_) || "null"); }
  catch (e) { return null; }
}

function writeAutoDutyProcess_(state) {
  PropertiesService.getScriptProperties().setProperty(R3_AUTO_DUTY_PROCESS_KEY_, JSON.stringify(state));
}

function autoDutySnapshotSignature_(snapshot, error) {
  const value = snapshot || { error: error || "unavailable" };
  try { return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, JSON.stringify(value))); }
  catch (e) { return JSON.stringify(value); }
}

function syncAutoDutyClockTrigger_() {
  const cfg = readAutoDutyConfig_();
  const state = readAutoDutyProcess_();
  const needed = !!cfg.activeMode || !!(state && state.status === "processing");
  const triggers = ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === "autoDutyClockTrigger_");
  if (needed && !triggers.length) ScriptApp.newTrigger("autoDutyClockTrigger_").timeBased().everyMinutes(1).create();
  if (!needed) triggers.forEach(t => ScriptApp.deleteTrigger(t));
}

function scheduleAutoDutyWake_(whenMs) {
  const props = PropertiesService.getScriptProperties();
  const existing = ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === "autoDutyWakeTrigger_");
  const storedAt = Number(props.getProperty(R3_AUTO_DUTY_WAKE_AT_KEY_) || 0);
  if (existing.length && storedAt && Math.abs(storedAt - Number(whenMs)) < 1000) return;
  existing.forEach(t => ScriptApp.deleteTrigger(t));
  const waitMs = Math.max(1000, Number(whenMs || Date.now() + 60000) - Date.now());
  ScriptApp.newTrigger("autoDutyWakeTrigger_").timeBased().after(waitMs).create();
  props.setProperty(R3_AUTO_DUTY_WAKE_AT_KEY_, String(Number(whenMs)));
}

function autoDutyClockTrigger_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  // Recover a missed final-confirmation callback on the one-minute safety
  // trigger. The browser status poll stays read-only and does not rescan sheets.
  try { startAutoDutyWhenAllConfirmed_(ss); } catch (e0) { console.error("Auto Duty confirmation recovery tick: " + e0); }
  try { autoDutyTick_(ss); } catch (e) { console.error("Auto Duty scheduled tick: " + e); }
  try { checkAutoDutyShiftTrigger_(ss); } catch (e2) { console.error("Auto Duty shift check: " + e2); }
  syncAutoDutyClockTrigger_();
}

// Run once from the Apps Script editor as the deployment owner to grant the
// trigger permission needed for Auto Duty scheduling.
function authorizeAutoDutyTriggers() {
  syncAutoDutyClockTrigger_();
  return "Auto Duty trigger authorization completed.";
}

function autoDutyWakeTrigger_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  PropertiesService.getScriptProperties().deleteProperty(R3_AUTO_DUTY_WAKE_AT_KEY_);
  try { autoDutyTick_(ss); } catch (e) { console.error("Auto Duty wake: " + e); }
  syncAutoDutyClockTrigger_();
}

function getAutoDutyConfig_(ss, params) {
  const authError = validateAdminDutyRequest_(ss, params);
  if (authError) return authError;
  const cfg = readAutoDutyConfig_();
  let triggerCheck = null;
  const statusOnly = String(params && params.statusOnly || "").toLowerCase() === "true";
  if (!statusOnly && ["1", "2"].includes(cfg.activeMode)) {
    const prior = readAutoDutyProcess_();
    const currentAssignment = getDutyConfirmationAssignment_(ss);
    const assignmentDate = currentAssignment && currentAssignment.snapshot && currentAssignment.snapshot.date || "";
    const settings = cfg.modeSettings[cfg.activeMode] || {};
    const sourceSheet = settings.sourceSheet || (cfg.activeMode === "1" ? "POSITION LINEUP" : R3_AUTO_DUTY_ADVANCE_SHEET_);
    const sourceResult = getAutoDutySourceSnapshot_(ss, sourceSheet);
    const sourceDate = sourceResult.snapshot && sourceResult.snapshot.date || "";
    const sourceSignature = autoDutySnapshotSignature_(sourceResult.snapshot, sourceResult.error);
    const sameCycle = prior && prior.mode === cfg.activeMode && prior.sourceSheet === sourceSheet &&
      prior.lineupDate === assignmentDate && prior.sourceDate === sourceDate && prior.sourceSignature === sourceSignature;
    // If the final confirmation callback was interrupted, checking the Admin
    // page recovers the current cycle. A matching in-flight or completed cycle
    // is left alone, so polling does not start duplicate writes.
    // Retry the exact multiple-OT failure after the corrected backend is
    // deployed; this failure happened before Duty Register values were written.
    if (sameCycle && !isRetryableAutoDutyMultipleOtFailure_(prior)) triggerCheck = { status: "existing-process", message: "The current assignment cycle already has a process record." };
    else {
      try { triggerCheck = startAutoDutyWhenAllConfirmed_(ss); }
      catch (e) { triggerCheck = { status: "error", message: String(e && e.message || e) }; }
    }
  }
  // Admin pages poll this endpoint frequently to mirror the shared countdown.
  // Do not run sheet scans, assignment recovery, or register writes on those
  // read-only polls; confirmation hooks and clock/wake triggers own processing.
  if (!statusOnly) autoDutyTick_(ss);
  const state = readAutoDutyProcess_();
  const process = state ? {
    processId: state.processId || "",
    mode: String(state.mode || ""),
    sourceSheet: String(state.sourceSheet || ""),
    status: String(state.status || ""),
    step: String(state.step || ""),
    message: String(state.message || ""),
    error: String(state.error || ""),
    lineupDate: String(state.lineupDate || ""),
    sourceDate: String(state.sourceDate || ""),
    dutyRegisterSaved: state.dutyRegisterSaved === true,
    dutyRegisterDate: String(state.dutyRegisterDate || ""),
    startedAt: Number(state.startedAt || 0),
    delayAt: Number(state.delayAt || 0),
    visibleAt: Number(state.visibleAt || 0),
    completedAt: Number(state.completedAt || state.publishedAt || 0)
  } : null;
  return { status: "success", config: readAutoDutyConfig_(), process: process, triggerCheck: triggerCheck };
}

function saveAutoDutyConfig_(ss, params) {
  const authError = validateAdminDutyRequest_(ss, params);
  if (authError) return authError;
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return { status: "error", message: "Another Auto Duty update is running. Please retry." };
  try {
    const old = readAutoDutyConfig_();
    // Preserve/migrate the currently visible assignment before settings can
    // change its source or active mode.
    try { autoDutyPublishedSnapshot_(ss); } catch (snapshotError) { console.error("Could not migrate last published Auto Duty snapshot: " + snapshotError); }
    const requestedMode = String(params && params.mode || "");
    const enabled = String(params && params.enabled || "false") === "true";
    const delaySeconds = Number(params && params.delaySeconds);
    const publishSeconds = Number(params && params.publishSeconds);
    const sourceSheet = String(params && params.sourceSheet || old.modeSettings[requestedMode] && old.modeSettings[requestedMode].sourceSheet || (requestedMode === "1" ? "POSITION LINEUP" : R3_AUTO_DUTY_ADVANCE_SHEET_));
    if (!["1", "2", "3"].includes(requestedMode)) return { status: "error", message: "Choose Auto Duty Mode 1, 2, or 3." };
    if (old.activeMode === "1" && requestedMode === "1" && sourceSheet !== String(old.modeSettings["1"] && old.modeSettings["1"].sourceSheet || "POSITION LINEUP")) {
      return { status: "error", message: "Mode 1 is ON. Turn Mode 1 OFF before changing its publish source." };
    }
    if (!Number.isInteger(delaySeconds) || delaySeconds < 0 || delaySeconds > 86400 || !Number.isInteger(publishSeconds) || publishSeconds < 0 || publishSeconds > 86400) {
      return { status: "error", message: "Delay Time and Publish Time must be whole seconds from 0 to 86400." };
    }
    if (!R3_AUTO_DUTY_SOURCES_.includes(sourceSheet)) return { status: "error", message: "Choose one of the three approved Auto Duty source sheets." };
    const otherActive = old.activeMode && old.activeMode !== requestedMode ? [old.activeMode] : [];
    if (enabled && otherActive.length) {
      return { status: "mode_conflict", activeModes: otherActive, message: "Mode " + otherActive.join(", ") + " is ON. Turn it OFF before enabling Mode " + requestedMode + "." };
    }
    const shiftTimes = {};
    for (const shift of ["A", "B", "C"]) {
      const time = String(params && params["shift" + shift] || old.shiftTimes[shift] || "");
      if (requestedMode === "3") {
        if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(time)) return { status: "error", message: "Set a valid trigger time (HH:MM) for " + shift + " Shift." };
        const minute = Number(time.slice(0, 2)) * 60 + Number(time.slice(3, 5));
        const inShift = shift === "A" ? minute >= 360 && minute < 840 : shift === "B" ? minute >= 840 && minute < 1320 : minute >= 1320 || minute < 360;
        if (!inShift) return { status: "error", message: "The " + shift + " Shift trigger must fall inside that shift's hours." };
      }
      shiftTimes[shift] = time;
    }
    const modeSettings = Object.assign({}, old.modeSettings);
    modeSettings[requestedMode] = { delaySeconds: delaySeconds, publishSeconds: publishSeconds, sourceSheet: sourceSheet };
    const next = { activeMode: enabled ? requestedMode : (old.activeMode === requestedMode ? "" : old.activeMode), modeSettings: modeSettings, shiftTimes: shiftTimes };
    PropertiesService.getScriptProperties().setProperty(R3_AUTO_DUTY_CONFIG_KEY_, JSON.stringify(next));
    // Configuration selects the next source. Keep the last published board
    // separate so turning Auto Duty OFF or changing its next source cannot
    // replace the assignment operators are currently confirming.
    try { CacheService.getScriptCache().remove("r3_dashboard_cache"); } catch (cacheError) {}
    try {
      syncAutoDutyClockTrigger_();
      return { status: "success", config: next, message: "Auto Duty settings saved." };
    } catch (triggerError) {
      return {
        status: "success", config: next, warning: true,
        message: "Settings were saved, but automatic scheduling could not start. Run authorizeAutoDutyTriggers from the Apps Script editor as the project owner and approve the requested permissions. Details: " + String(triggerError && triggerError.message || triggerError)
      };
    }
  } finally { lock.releaseLock(); }
}

function resetAutoDutyTestState_(ss, params) {
  const authError = validateAdminDutyRequest_(ss, params);
  if (authError) return authError;
  if (String(params && params.confirm || "") !== "true") {
    return { status: "error", message: "Confirm the Auto Duty published-state reset first." };
  }

  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return { status: "error", message: "Another Auto Duty update is running. Please retry." };
  try {
    const cfg = readAutoDutyConfig_();
    if (cfg.activeMode) {
      return { status: "error", message: "Turn OFF Auto Duty Mode " + cfg.activeMode + " before resetting the published test state." };
    }
    const process = readAutoDutyProcess_();
    if (process && process.status === "processing") {
      return { status: "error", message: "An Auto Duty process is still running. Wait for it to finish before resetting." };
    }

    const props = PropertiesService.getScriptProperties();
    props.deleteProperty(R3_AUTO_DUTY_LAST_PUBLISHED_KEY_);
    props.deleteProperty(R3_AUTO_DUTY_PROCESS_KEY_);
    // Reset a test run's shift de-duplication key as well; otherwise a retry
    // at the same shift time/date would be silently skipped after reset.
    props.deleteProperty(R3_AUTO_DUTY_LAST_SHIFT_KEY_);
    props.deleteProperty(R3_AUTO_DUTY_WAKE_AT_KEY_);
    ScriptApp.getProjectTriggers()
      .filter(trigger => trigger.getHandlerFunction() === "autoDutyWakeTrigger_")
      .forEach(trigger => ScriptApp.deleteTrigger(trigger));
    try { CacheService.getScriptCache().remove("r3_dashboard_cache"); } catch (cacheError) {}
    syncAutoDutyClockTrigger_();
    return {
      status: "success",
      config: readAutoDutyConfig_(),
      message: "Auto Duty published test state reset. Duty Register and Submitted Duty Log were not changed."
    };
  } catch (error) {
    return { status: "error", message: String(error && error.message || error) };
  } finally { lock.releaseLock(); }
}

function isRetryableAutoDutyMultipleOtFailure_(process) {
  return !!process && String(process.status || "") === "failed" &&
    /selected source assigns OT to more than one Duty Register position/i.test(String(process.error || ""));
}

function isoAddDays_(isoDate, days) {
  const p = String(isoDate || "").split("-").map(Number);
  if (p.length !== 3 || !p[0] || !p[1] || !p[2]) return "";
  const date = new Date(Date.UTC(p[0], p[1] - 1, p[2] + Number(days || 0)));
  return Utilities.formatDate(date, "UTC", "yyyy-MM-dd");
}

function getAutoDutyShiftForDate_(ss, date) {
  const sheet = getSheetFuzzy(ss, "Shift Schedule");
  if (!sheet || sheet.getLastRow() < 2 || !date) return "";
  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 3).getValues();
  for (let i = 0; i < rows.length; i++) if (normalizeDateStr(rows[i][0]) === date) return String(rows[i][2] || "").trim().toUpperCase();
  return "";
}

function getAutoDutySourceSnapshot_(ss, sourceName) {
  const source = String(sourceName || "");
  if (!R3_AUTO_DUTY_SOURCES_.includes(source)) return { error: "Choose a valid source sheet." };
  const sheet = source === R3_AUTO_DUTY_ADVANCE_SHEET_ ? ss.getSheetByName(source) : getSheetFuzzy(ss, source);
  if (!sheet) return { error: source + " sheet is missing." };
  const bannerCandidates = [String(sheet.getRange("C7").getDisplayValue() || "").trim(), String(sheet.getRange("C8").getDisplayValue() || "").trim()];
  const banner = bannerCandidates.find(v => /(\d{1,2}[\/-]\d{1,2}[\/-]\d{4}|\d{4}-\d{2}-\d{2})/.test(v)) || bannerCandidates.find(Boolean) || "";
  const match = banner.match(/(\d{1,2}[\/-]\d{1,2}[\/-]\d{4}|\d{4}-\d{2}-\d{2})/);
  let date = match ? normalizeDateStr(match[1]) : "";
  let rows = [];
  let availableCount = "0", standBy = "-", offDay = "None", leave = "None", info = "-";

  if (source === "Maintenance Day_Lineup") {
    const maintenance = getMaintenanceDayLineup_(ss, readMaintenanceConfig_(ss).maintenanceLineupDate);
    const dateValue = readMaintenanceConfig_(ss).maintenanceLineupDate;
    if (!date) date = normalizeDateStr(dateValue);
    if (!maintenance.headers.length || !maintenance.rows.length) return { error: "Maintenance Day_Lineup assignments are unavailable." };
    const posIndex = maintenance.headers.findIndex(h => String(h || "").trim().toLowerCase() === "position");
    const opIndex = maintenance.headers.findIndex(h => /^(recommended|recommended operator|operator)$/i.test(String(h || "").trim()));
    if (posIndex < 0 || opIndex < 0) return { error: "Maintenance Day_Lineup must contain Position and Recommended Operator columns." };
    rows = maintenance.rows.map(r => ({ pos: String(r[posIndex] || "").trim(), duty: String(r[opIndex] || "-").trim() || "-" })).filter(r => r.pos);
    info = maintenance.title || "-";
  } else {
    const values = sheet.getRange(10, 3, 9, 6).getDisplayValues();
    rows = values.map(r => ({ pos: String(r[0] || "").trim(), duty: r.slice(1).map(x => String(x || "-").trim() || "-").join(" - ") })).filter(r => r.pos);
    availableCount = sheet.getRange("D19").getDisplayValue() || "0";
    standBy = sheet.getRange("F19").getDisplayValue() || sheet.getRange("G19").getDisplayValue() || sheet.getRange("H19").getDisplayValue() || "-";
    offDay = sheet.getRange("D20").getDisplayValue() || "None";
    leave = sheet.getRange("D21").getDisplayValue() || "None";
    info = sheet.getRange("D22").getDisplayValue() || "-";
  }
  if (!date) return { error: source + " date could not be read from its banner or configured maintenance date." };
  const assignedNames = rows.map(r => String(r.duty || "").split(/\s+-\s+/)[0].trim()).filter(n => n && n !== "-" && !["ot", "h", "m", "l", "a"].includes(n.toLowerCase()));
  const seen = new Set();
  for (const name of assignedNames) { const key = name.toLowerCase(); if (seen.has(key)) return { error: source + " contains a duplicate operator assignment: " + name + "." }; seen.add(key); }
  if (!rows.length || !assignedNames.length) return { error: source + " assignments are unavailable." };
  const shift = getAutoDutyShiftForDate_(ss, date) || "-";
  const day = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][new Date(date + "T00:00:00Z").getUTCDay()];
  return { snapshot: { date: date, dateBanner: formatDisplayDate(date) + " - " + day + " | R3 Shift: " + shift, rows: rows, availableCount: availableCount, standBy: standBy, offDay: offDay, leave: leave, info: info }, sheetName: source };
}

function buildAutoDutyRegisterValues_(snapshot, headers) {
  const values = new Array(headers.length).fill("");
  const used = new Set();
  (snapshot.rows || []).forEach(item => {
    const pos = String(item.pos || item.position || "").toLowerCase().replace(/[^a-z0-9]/g, "");
    const rawDuty = String(item.duty || item.operator || "").trim();
    const operator = rawDuty.split(/\s+-\s+/)[0].trim();
    // OT is a valid Duty Register entry (commonly used in Reliever positions).
    // Leave the other status markers out of the assigned operator columns.
    if (!operator || operator === "-" || ["h", "m", "l", "a"].includes(operator.toLowerCase())) return;
    let candidates = [];
    if (pos.includes("machine")) candidates = headers.map((h, i) => ({ h, i })).filter(x => x.h.toLowerCase().replace(/[^a-z0-9]/g, "").includes("machine"));
    else if (pos.includes("reliever")) candidates = headers.map((h, i) => ({ h, i })).filter(x => x.h.toLowerCase().replace(/[^a-z0-9]/g, "").includes("reliever"));
    else candidates = headers.map((h, i) => ({ h, i })).filter(x => x.h.toLowerCase().replace(/[^a-z0-9]/g, "") === pos);
    const chosen = candidates.find(x => !used.has(x.i));
    if (!chosen) throw new Error("Source position does not match a Duty Register column: " + (item.pos || item.position));
    values[chosen.i] = operator;
    used.add(chosen.i);
  });
  if (!values.some(v => v)) throw new Error("The selected source has no operator names for Duty Register.");
  const seen = new Set();
  // OT marks an unfilled operator position and may legitimately appear in
  // multiple positions on the same shift. Keep duplicate protection for
  // named operators and other entries, but do not reject repeated OT values.
  values.forEach(v => {
    const name = String(v || "").trim().toLowerCase();
    if (!name || name === "ot") return;
    if (seen.has(name)) throw new Error("The selected source assigns " + v + " to more than one Duty Register position.");
    seen.add(name);
  });
  return values;
}

function writeConfirmedPositionLineupToRegister_(ss, snapshot, processId) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return { status: "error", message: "Another duty update is in progress. Please try again." };
  try {
    const sheet = getDutyRegisterSheet_(ss);
    if (!sheet) return { status: "error", message: "Duty Register sheet not found." };
    const headers = getDutyRegisterHeaders_(sheet);
    const targetDate = normalizeDateStr(snapshot && snapshot.date);
    if (!targetDate) return { status: "error", message: "Check Position and Confirm Duty date could not be read." };
    const row = findDutyRegisterRow_(sheet, targetDate);
    if (row < 0) return { status: "error", message: "No Duty Register row exists for the Check Position and Confirm Duty date " + formatDisplayDate(targetDate) + "." };
    const proposed = buildAutoDutyRegisterValues_(snapshot, headers);
    const existing = sheet.getRange(row, 3, 1, headers.length).getDisplayValues()[0].map(v => String(v || "").trim());
    const markerKey = "R3_AUTO_DUTY_CONFIRMED_WRITE_" + targetDate;
    const props = PropertiesService.getScriptProperties();
    let priorWrite = null;
    try { priorWrite = JSON.parse(props.getProperty(markerKey) || "null"); } catch (e) {}
    const sameProcessWrite = !!(priorWrite && priorWrite.processId === processId && ["writing", "written"].includes(priorWrite.status));
    const merged = existing.slice();
    for (let i = 0; i < proposed.length; i++) {
      if (!proposed[i]) continue;
      if (existing[i] && existing[i].toLowerCase() !== proposed[i].toLowerCase()) return { status: "error", message: "Duty Register already has a different operator in " + headers[i] + " for " + formatDisplayDate(targetDate) + ". Nothing was overwritten." };
      merged[i] = proposed[i];
    }
    if (sameProcessWrite && merged.every((value, i) => !proposed[i] || String(value).toLowerCase() === String(proposed[i]).toLowerCase())) {
      props.setProperty(markerKey, JSON.stringify({ processId: processId, row: row, values: merged, status: "written", writtenAt: Date.now() }));
      return { status: "success", message: "Confirmed Position Lineup is already saved in Duty Register for " + formatDisplayDate(targetDate) + ".", date: targetDate, rowNumber: row, alreadyWritten: true };
    }
    props.setProperty(markerKey, JSON.stringify({ processId: processId, row: row, values: merged, status: "writing", writtenAt: Date.now() }));
    if (merged.some((value, i) => existing[i] !== value)) sheet.getRange(row, 3, 1, headers.length).setValues([merged]);
    props.setProperty(markerKey, JSON.stringify({ processId: processId, row: row, values: merged, status: "written", writtenAt: Date.now() }));
    try { CacheService.getScriptCache().remove("r3_dashboard_cache"); } catch (e) {}
    return { status: "success", message: "Confirmed Position Lineup saved to Duty Register for " + formatDisplayDate(targetDate) + ".", date: targetDate, rowNumber: row };
  } catch (error) { return { status: "error", message: String(error && error.message || error) }; }
  finally { lock.releaseLock(); }
}

function startAutoDutyProcess_(ss, mode, source, shiftKey, shiftDateOverride) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return { status: "error", message: "Another Auto Duty process is starting. Please retry." };
  let state;
  try {
    const cfg = readAutoDutyConfig_();
    if (cfg.activeMode !== String(mode)) return { status: "error", message: "Auto Duty Mode " + mode + " is not ON." };
    if (String(mode) === "1" && String(source || "") === "all-operators-confirmed") {
      const confirmed = fetchDutyStatusSummary(ss, { usePublishedSnapshot: true });
      if (!confirmed || !confirmed.totalAssigned || confirmed.submittedCount !== confirmed.totalAssigned) return { status: "waiting-confirmations", message: "Still All duty not confirm." };
    }
    const prior = readAutoDutyProcess_();
    const assignment = getAutoDutyRegisterAssignment_(ss, mode);
    const assignmentDate = normalizeDateStr(assignment && assignment.date);
    if (!assignmentDate) return { status: "error", message: "The active assignment date could not be read." };
    if (prior && prior.status === "processing") return { status: "success", process: prior, alreadyRunning: true };
    const modeSettings = cfg.modeSettings[String(mode)] || { delaySeconds: 5, publishSeconds: 60 };
    const sourceSheet = modeSettings.sourceSheet || (String(mode) === "1" ? "POSITION LINEUP" : R3_AUTO_DUTY_ADVANCE_SHEET_);
    const sourceResult = getAutoDutySourceSnapshot_(ss, sourceSheet);
    const requestedSourceDate = sourceResult.snapshot && sourceResult.snapshot.date || "";
    const requestedSourceSignature = autoDutySnapshotSignature_(sourceResult.snapshot, sourceResult.error);
    let sourceValidationError = "";
    if (!sourceResult.snapshot) sourceValidationError = sourceResult.error || "Selected source data could not be read.";
    // Publish the selected sheet as it is configured, even when its displayed
    // date is equal to, earlier than, or later than the confirmed assignment.
    // The confirmed lineup's own date is used only to select the Duty Register
    // row that receives the confirmations.
    // A sheet date can remain the same while the confirmed Duty Register
    // assignment date advances. Treat that as a new publish cycle; dedupe only
    // when both the selected source date and the confirmed lineup date match.
    const sameSourceAndDate = prior && prior.mode === String(mode) && prior.sourceSheet === sourceSheet && prior.sourceDate === requestedSourceDate && prior.lineupDate === assignmentDate && (String(mode) === "3" ? prior.shiftKey === String(shiftKey || "") : true);
    if (sameSourceAndDate && prior.status === "published" && prior.sourceSignature === requestedSourceSignature) return { status: "success", process: prior, alreadyRunning: true };
    if (sameSourceAndDate && prior.sourceSignature === requestedSourceSignature && ["failed", "cancelled"].includes(prior.status) && !isRetryableAutoDutyMultipleOtFailure_(prior)) return { status: "success", process: prior, alreadyRunning: true };
    const now = Date.now();
    const delayAt = now + modeSettings.delaySeconds * 1000;
    const publishAt = delayAt + modeSettings.publishSeconds * 1000;
    const visibleAt = publishAt;
    const confirmedLineupSnapshot = { date: assignmentDate, rows: assignment.rows };
    const processShiftDate = String(shiftDateOverride || assignmentDate);
    state = { processId: Utilities.getUuid(), mode: String(mode), source: String(source || "auto"), sourceSheet: sourceSheet, sourceSignature: requestedSourceSignature, status: "processing", step: "delay", startedAt: now, delayAt: delayAt, publishAt: publishAt, visibleAt: visibleAt, lineupDate: assignmentDate, sourceDate: requestedSourceDate, sourceValidationError: sourceValidationError, shiftDate: processShiftDate, shift: String(sourceResult.snapshot && (sourceResult.snapshot.dateBanner.match(/R3 Shift: ([^|]+)/) || [])[1] || getAutoDutyShiftForDate_(ss, processShiftDate) || ""), shiftKey: String(shiftKey || ""), message: "Duty allocation in progress", confirmedLineupSnapshot: confirmedLineupSnapshot, snapshot: sourceResult.snapshot || null };
    writeAutoDutyProcess_(state);
    syncAutoDutyClockTrigger_();
  } finally { lock.releaseLock(); }
  if (state.status === "processing") scheduleAutoDutyWake_(state.delayAt);
  return { status: "success", process: state };
}

function startAutoDutyWhenAllConfirmed_(ss) {
  const cfg = readAutoDutyConfig_();
  if (!["1", "2"].includes(cfg.activeMode)) return { status: "inactive", message: "Mode 1 or Mode 2 is not active." };
  const assignment = getDutyConfirmationAssignment_(ss);
  const assignmentDate = assignment && assignment.snapshot && assignment.snapshot.date || "";
  const prior = readAutoDutyProcess_();
  const priorMatchesCycle = prior && String(prior.mode || "") === cfg.activeMode && String(prior.lineupDate || "") === String(assignmentDate || "");
  if (priorMatchesCycle && String(prior.status || "") === "processing") {
    return { status: "existing-process", message: "The current assignment cycle already has a process record.", process: prior };
  }
  const summary = fetchDutyStatusSummary(ss, { usePublishedSnapshot: true });
  const allConfirmedForAssignedNames = summary && summary.totalAssigned > 0 && summary.submittedCount === summary.totalAssigned &&
    (summary.summary || []).length === summary.totalAssigned && (summary.summary || []).every(item => {
      const assignedName = String(item.operator || "").split(/\s+-\s+/)[0].trim().toLowerCase();
      const submittedValue = String(item.info || "").toLowerCase();
      return item.status === "submitted" && !!assignedName && submittedValue.indexOf(assignedName) >= 0;
    });
  if (!allConfirmedForAssignedNames) return {
    status: "waiting-confirmations",
    submittedCount: Number(summary && summary.submittedCount || 0),
    totalAssigned: Number(summary && summary.totalAssigned || 0),
    message: "Still All duty not confirm."
  };
  return startAutoDutyProcess_(ss, cfg.activeMode, "all-operators-confirmed", "");
}

function getAutoDutyRegisterAssignment_(ss, mode) {
  // Mode 1/2 confirmations belong to the assignment displayed on the Admin
  // confirmation page (including a previously published source snapshot).
  // Mode 3 is time-triggered and saves the current running Position LineUp.
  if (String(mode) === "3") {
    const lineup = getPositionLineupSnapshot_(ss);
    return { date: lineup.date, rows: (lineup.items || []).map(item => ({ pos: item.position, duty: item.operator })) };
  }
  const assignment = getDutyConfirmationAssignment_(ss);
  const snapshot = assignment && assignment.snapshot;
  if (!snapshot) return { date: "", rows: [] };
  const rows = snapshot.rows || snapshot.items || [];
  return {
    date: snapshot.date,
    rows: rows.map(item => ({
      pos: String(item.pos || item.position || "").trim(),
      duty: String(item.duty || item.operator || "").trim()
    }))
  };
}

function checkAutoDutyShiftTrigger_(ss) {
  const cfg = readAutoDutyConfig_();
  if (cfg.activeMode !== "3") return;
  const now = new Date();
  const dateToday = Utilities.formatDate(now, "Asia/Kolkata", "yyyy-MM-dd");
  const hour = Number(Utilities.formatDate(now, "Asia/Kolkata", "H"));
  const minutePart = Number(Utilities.formatDate(now, "Asia/Kolkata", "m"));
  const currentMinute = hour * 60 + minutePart;
  const shift = currentMinute >= 360 && currentMinute < 840 ? "A" : currentMinute >= 840 && currentMinute < 1320 ? "B" : "C";
  const shiftDate = shift === "C" && currentMinute < 360 ? isoAddDays_(dateToday, -1) : dateToday;
  const lineup = getPositionLineupSnapshot_(ss);
  if (!lineup.date || !shiftDate) return;
  const parts = String(cfg.shiftTimes[shift] || "").split(":").map(Number);
  const targetMinute = parts[0] * 60 + parts[1];
  const withinConfiguredShiftWindow = shift !== "C" || (targetMinute < 360 ? currentMinute < 360 : currentMinute >= 1320);
  if (!withinConfiguredShiftWindow || !Number.isFinite(targetMinute) || currentMinute < targetMinute) return;
  const key = shiftDate + "|" + shift;
  if (PropertiesService.getScriptProperties().getProperty(R3_AUTO_DUTY_LAST_SHIFT_KEY_) === key) return;
  const result = startAutoDutyProcess_(ss, "3", "shift-trigger", key, shiftDate);
  if (result && result.status === "success" && result.process && result.process.shiftKey === key) PropertiesService.getScriptProperties().setProperty(R3_AUTO_DUTY_LAST_SHIFT_KEY_, key);
}

function autoDutyTick_(ss) {
  let state = readAutoDutyProcess_();
  if (!state || state.status !== "processing") return state;
  if (state.step === "working" && Date.now() - Number(state.workingAt || Date.now()) > 300000) {
    const recoveryLock = LockService.getScriptLock();
    if (recoveryLock.tryLock(10000)) {
      try {
        const interrupted = readAutoDutyProcess_();
        if (interrupted && interrupted.processId === state.processId && interrupted.status === "processing" && interrupted.step === "working" && Date.now() - Number(interrupted.workingAt || Date.now()) > 300000) {
          interrupted.recoveryAttempts = Number(interrupted.recoveryAttempts || 0) + 1;
          if (interrupted.recoveryAttempts >= 3) {
            interrupted.status = "failed"; interrupted.step = "failed";
            interrupted.error = "Processing did not finish after three safe recovery attempts. Review Duty Register and the selected source sheet.";
            interrupted.completedAt = Date.now();
          } else {
            interrupted.step = "delay"; interrupted.delayAt = Date.now(); interrupted.workingAt = 0;
          }
          writeAutoDutyProcess_(interrupted);
          state = interrupted;
        }
      } finally { recoveryLock.releaseLock(); }
    }
    if (state.status !== "processing") return state;
  }
  if (state.step === "delay" && Date.now() >= Number(state.delayAt || 0)) {
    const lock = LockService.getScriptLock();
    if (!lock.tryLock(10000)) return state;
    try {
      state = readAutoDutyProcess_();
      if (!state || state.status !== "processing" || state.step !== "delay") return state;
      state.step = "working";
      state.workingAt = Date.now();
      writeAutoDutyProcess_(state);
    } finally { lock.releaseLock(); }
    let result = writeConfirmedPositionLineupToRegister_(ss, state.confirmedLineupSnapshot || {}, state.processId);
    const finishLock = LockService.getScriptLock();
    if (!finishLock.tryLock(10000)) return state;
    try {
      const current = readAutoDutyProcess_();
      if (!current || current.processId !== state.processId || current.status !== "processing") return current;
      if (!result || result.status !== "success") {
        current.status = "failed";
        current.step = "failed";
        current.error = result && result.message || "Auto Duty processing failed.";
        current.completedAt = Date.now();
      } else {
        current.dutyRegisterSaved = true;
        current.dutyRegisterDate = result.date || current.lineupDate;
        if (current.sourceValidationError) {
          current.status = "failed";
          current.step = "failed";
          current.error = current.sourceValidationError;
          current.completedAt = Date.now();
        } else {
          // The selected source may contain formulas driven by the Duty Register.
          // The snapshot captured when processing began can therefore be stale
          // (especially POSITION LINEUP). Flush the confirmed assignments, then
          // prepare the exact board that operators should see before starting
          // the publish countdown.
          let preparedSource = null;
          try {
            SpreadsheetApp.flush();
            preparedSource = getAutoDutySourceSnapshot_(ss, current.sourceSheet);
          } catch (prepareError) {
            preparedSource = { error: String(prepareError && prepareError.message || prepareError) };
          }
          if (!preparedSource || !preparedSource.snapshot) {
            current.status = "failed";
            current.step = "failed";
            current.error = (preparedSource && preparedSource.error) || "The selected sheet could not be prepared after Duty Register was updated.";
            current.completedAt = Date.now();
          } else {
            current.snapshot = preparedSource.snapshot;
            current.sourceDate = preparedSource.snapshot.date || current.sourceDate;
            current.sourceSignature = autoDutySnapshotSignature_(preparedSource.snapshot, "");
            current.step = "waiting-publish";
            current.preparedAt = Date.now();
            current.message = result.message || "Duty Register updated and selected sheet prepared.";
          }
        }
      }
      writeAutoDutyProcess_(current);
      state = current;
    } finally { finishLock.releaseLock(); }
  }
  state = readAutoDutyProcess_();
  if (state && state.status === "processing" && state.step === "waiting-publish" && Date.now() >= Number(state.visibleAt || 0)) {
    const lock2 = LockService.getScriptLock();
    if (lock2.tryLock(10000)) {
      try {
        const current = readAutoDutyProcess_();
        if (current && current.processId === state.processId && current.status === "processing" && current.step === "waiting-publish" && Date.now() >= Number(current.visibleAt || 0)) {
          current.status = "published";
          current.step = "published";
          current.publishedAt = Date.now();
          current.message = "Duty allocation published.";
          writeAutoDutyProcess_(current);
          saveLastAutoDutyPublishedSnapshot_(current);
          try { CacheService.getScriptCache().remove("r3_dashboard_cache"); } catch (e) {}
          state = current;
        }
      } finally { lock2.releaseLock(); }
    }
  }
  if (state && state.status === "processing") {
    const nextAt = state.step === "waiting-publish" ? state.visibleAt : (state.step === "working" ? Date.now() + 60000 : state.delayAt);
    if (Number(nextAt) > Date.now()) scheduleAutoDutyWake_(nextAt);
  } else syncAutoDutyClockTrigger_();
  return state;
}

function getAutoDutyOperatorState_(ss) {
  const state = autoDutyTick_(ss);
  const boardOverrideActive = !!autoDutyPublishedSnapshot_(ss);
  if (!state) return { status: "success", active: false, process: null, boardOverrideActive: false };
  const safe = Object.assign({}, state);
  if (safe.status !== "published") safe.snapshot = null;
  safe.confirmedLineupSnapshot = null;
  safe.operatorConfirmationOpen = safe.status === "published" && !!safe.snapshot && isAutoDutyOperatorConfirmationOpen_(ss, safe.snapshot.date);
  const activeMode = readAutoDutyConfig_().activeMode;
  const visibleProcess = state.status !== "processing" && activeMode !== String(state.mode) ? null : safe;
  return { status: "success", active: state.status === "processing", process: visibleProcess, boardOverrideActive: boardOverrideActive };
}

function autoDutyPublishedSnapshot_(ss) {
  let saved = null;
  try { saved = JSON.parse(PropertiesService.getScriptProperties().getProperty(R3_AUTO_DUTY_LAST_PUBLISHED_KEY_) || "null"); } catch (e) {}
  const state = readAutoDutyProcess_();
  // Migrate snapshots published by earlier versions. If an earlier settings
  // save cleared the snapshot, safely rebuild it only when the source still
  // contains the same published date.
  if (!saved && state && ["published", "superseded"].includes(String(state.status)) && ["1", "2", "3"].includes(String(state.mode))) {
    let snapshot = state.snapshot || null;
    if (!snapshot && state.sourceSheet && state.sourceDate) {
      const rebuilt = getAutoDutySourceSnapshot_(ss, state.sourceSheet);
      if (rebuilt.snapshot && normalizeDateStr(rebuilt.snapshot.date) === normalizeDateStr(state.sourceDate)) snapshot = rebuilt.snapshot;
    }
    if (snapshot && normalizeDateStr(snapshot.date) === normalizeDateStr(state.sourceDate || snapshot.date)) {
      saved = { snapshot: snapshot, lineupDate: state.lineupDate || "", mode: String(state.mode), sourceSheet: state.sourceSheet || "", publishedAt: state.publishedAt || state.supersededAt || 0 };
      saveLastAutoDutyPublishedSnapshot_(saved);
    }
  }
  if (!saved || !saved.snapshot) return null;
  const current = getPositionLineupSnapshot_(ss);
  // The selected source can be for the day after the confirmed lineup date.
  // Keep showing the published source while the app is on either date; once
  // the board advances beyond both dates, fall back to the normal lineup.
  return current.date === saved.lineupDate || current.date === saved.snapshot.date ? saved.snapshot : null;
}

function saveLastAutoDutyPublishedSnapshot_(processOrSnapshot) {
  if (!processOrSnapshot) return;
  const value = processOrSnapshot.snapshot
    ? { snapshot: processOrSnapshot.snapshot, lineupDate: processOrSnapshot.lineupDate || "", mode: String(processOrSnapshot.mode || ""), sourceSheet: processOrSnapshot.sourceSheet || "", publishedAt: processOrSnapshot.publishedAt || Date.now() }
    : processOrSnapshot;
  if (!value.snapshot || !normalizeDateStr(value.snapshot.date)) return;
  PropertiesService.getScriptProperties().setProperty(R3_AUTO_DUTY_LAST_PUBLISHED_KEY_, JSON.stringify(value));
}

function applyAutoDutyPublishedSnapshot_(ss, result) {
  const snapshot = autoDutyPublishedSnapshot_(ss);
  if (!snapshot || !result || !result.board) return result;
  result.lineupStatus = "Published";
  result.autoDutyAdvancePublished = !isAutoDutyOperatorConfirmationOpen_(ss, snapshot.date);
  result.board = { dateBanner: snapshot.dateBanner, rows: snapshot.rows, availableCount: snapshot.availableCount, standBy: snapshot.standBy, offDay: snapshot.offDay, leave: snapshot.leave, info: snapshot.info };
  return result;
}

function isAutoDutyOperatorConfirmationOpen_(ss, assignmentDate) {
  const date = normalizeDateStr(assignmentDate);
  const shift = getAutoDutyShiftForDate_(ss, date);
  if (!date || !["A", "B", "C"].includes(shift)) return false;
  const now = new Date();
  const today = Utilities.formatDate(now, "Asia/Kolkata", "yyyy-MM-dd");
  const minutes = Number(Utilities.formatDate(now, "Asia/Kolkata", "H")) * 60 + Number(Utilities.formatDate(now, "Asia/Kolkata", "m"));
  if (shift === "A") return today === date && minutes >= 360 && minutes < 840;
  if (shift === "B") return today === date && minutes >= 840 && minutes < 1320;
  return (today === date && minutes >= 1320) || (today === isoAddDays_(date, 1) && minutes < 480);
}

function getDutyConfirmationAssignment_(ss) {
  const published = autoDutyPublishedSnapshot_(ss);
  if (published) return { snapshot: published, isPublished: true };
  const lineup = getPositionLineupSnapshot_(ss);
  if (!lineup || !lineup.date) return { snapshot: null, isPublished: false };
  return { snapshot: { date: lineup.date, rows: (lineup.items || []).map(item => ({ pos: item.position, duty: item.operator })) }, isPublished: false };
}

function findAssignedDutyOperator_(snapshot, position, operatorName) {
  const wantedPosition = String(position || "").trim().toLowerCase();
  // The Admin confirmation list displays the full duty string (name, due,
  // history, day, shift), so accept either that string or a plain operator name.
  const wantedName = String(operatorName || "").trim().split(/\s+-\s+/)[0].trim().toLowerCase();
  for (const row of (snapshot && snapshot.rows) || []) {
    const rowPosition = String(row.pos || row.position || "").trim();
    const rawDuty = String(row.duty || row.operator || "").trim();
    const cleanName = rawDuty.split(/\s+-\s+/)[0].trim();
    if (rowPosition.toLowerCase() === wantedPosition && cleanName.toLowerCase() === wantedName) return { position: rowPosition, operator: cleanName, rawDuty: rawDuty };
  }
  return null;
}

function getDutyRegisterDateInfo_(ss, date, dayFromRegister) {
  let day = String(dayFromRegister || "").trim();
  let shift = "";
  const sheet = getSheetFuzzy(ss, "Shift Schedule");
  if (sheet && sheet.getLastRow() >= 2) {
    const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 5).getValues();
    for (let i = 0; i < rows.length; i++) {
      if (normalizeDateStr(rows[i][0]) === date) {
        day = day || String(rows[i][1] || "").trim();
        shift = String(rows[i][2] || "").trim();
        break;
      }
    }
  }
  return { day: day, shift: shift };
}

function getHistoricalLineupForDate_(ss, headers, date, currentRow, lineupSuggestions) {
  const sheet = getDutyRegisterSheet_(ss);
  if (!sheet || sheet.getLastRow() < 2) return [];
  const start = 2;
  const count = sheet.getLastRow() - 1;
  const records = sheet.getRange(start, 1, count, headers.length + 2).getValues();
  const shifts = {};
  const schedule = getSheetFuzzy(ss, "Shift Schedule");
  if (schedule && schedule.getLastRow() >= 2) {
    schedule.getRange(2, 1, schedule.getLastRow() - 1, 3).getValues().forEach(r => {
      const d = normalizeDateStr(r[0]);
      if (d) shifts[d] = String(r[2] || "-").trim() || "-";
    });
  }
  const currentDate = normalizeDateStr(date);
  const current = records.findIndex((r, i) => start + i === currentRow);
  const currentValues = current >= 0 ? records[current].slice(2) : new Array(headers.length).fill("");
  const weekday = d => {
    const parts = String(d || "").split("-").map(Number);
    if (parts.length !== 3 || !parts[0]) return "-";
    return ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][new Date(Date.UTC(parts[0], parts[1] - 1, parts[2])).getUTCDay()];
  };
  const dayGap = (later, earlier) => {
    const a = String(later || "").split("-").map(Number);
    const b = String(earlier || "").split("-").map(Number);
    if (a.length !== 3 || b.length !== 3 || !a[0] || !b[0]) return null;
    return Math.round((Date.UTC(a[0], a[1] - 1, a[2]) - Date.UTC(b[0], b[1] - 1, b[2])) / 86400000);
  };

  return headers.map((header, col) => {
    const operator = String(currentValues[col] || (lineupSuggestions || [])[col] || "").trim();
    let lastDate = "";
    const headerKey = String(header || "").toLowerCase().replace(/[^a-z0-9]/g, "");
    const groupKey = headerKey.includes("machine") ? "machine" : (headerKey.includes("reliever") ? "reliever" : headerKey);
    const searchCols = headers.map((h, i) => ({ key: String(h || "").toLowerCase().replace(/[^a-z0-9]/g, ""), i }))
      .filter(x => groupKey === "machine" ? x.key.includes("machine") : (groupKey === "reliever" ? x.key.includes("reliever") : x.i === col))
      .map(x => x.i);
    if (operator && !["ot", "h", "m", "l", "a"].includes(operator.toLowerCase())) {
      records.forEach((r, i) => {
        const recordDate = normalizeDateStr(r[0]);
        const operatorWorkedInGroup = searchCols.some(searchCol => String(r[searchCol + 2] || "").trim().toLowerCase() === operator.toLowerCase());
        if (recordDate && recordDate < currentDate && operatorWorkedInGroup && (!lastDate || recordDate > lastDate)) lastDate = recordDate;
      });
    }
    const gap = lastDate ? dayGap(currentDate, lastDate) : null;
    const displayPosition = String(header || "").replace(/^Machine1$/i, "Machine").replace(/^Reliever1$/i, "Reliever");
    return {
      position: displayPosition,
      registerPosition: header,
      operator: operator,
      due: gap == null ? "-" : String(Math.max(0, gap - 1)),
      lastDate: lastDate ? formatDisplayDate(lastDate) : "-",
      lastDay: lastDate ? weekday(lastDate) : "-",
      lastShift: lastDate ? (shifts[lastDate] || "-") : "-"
    };
  });
}

function mapDutyLineupSuggestions_(headers, lineupItems) {
  const suggestions = new Array(headers.length).fill("");
  const used = new Set();
  const clean = value => String(value || "").toLowerCase().replace(/[^a-z0-9]/g, "");
  (lineupItems || []).forEach(item => {
    const pos = clean(item.position);
    let candidates = [];
    if (pos.includes("machine")) {
      candidates = headers.map((h, i) => ({ name: clean(h), i })).filter(x => x.name.includes("machine"));
      if (pos.includes("machine2")) candidates.sort((a, b) => Number(b.name.includes("machine2")) - Number(a.name.includes("machine2")));
      else if (pos.includes("machine1")) candidates.sort((a, b) => Number(b.name.includes("machine1")) - Number(a.name.includes("machine1")));
    } else if (pos.includes("reliever")) {
      candidates = headers.map((h, i) => ({ name: clean(h), i })).filter(x => x.name.includes("reliever"));
      if (pos.includes("reliever2")) candidates.sort((a, b) => Number(b.name.includes("reliever2")) - Number(a.name.includes("reliever2")));
      else if (pos.includes("reliever1")) candidates.sort((a, b) => Number(b.name.includes("reliever1")) - Number(a.name.includes("reliever1")));
    } else {
      candidates = headers.map((h, i) => ({ name: clean(h), i })).filter(x => x.name === pos);
    }
    const chosen = candidates.find(x => !used.has(x.i));
    const operator = String(item.operator || "").trim();
    if (chosen && operator) {
      suggestions[chosen.i] = operator;
      used.add(chosen.i);
    }
  });
  return suggestions;
}

function getAdminDutyRegister_(ss, params) {
  const authError = validateAdminDutyRequest_(ss, params);
  if (authError) return authError;

  const sheet = getDutyRegisterSheet_(ss);
  if (!sheet) return { status: "error", message: "Duty Register sheet not found." };
  const headers = getDutyRegisterHeaders_(sheet);
  if (!headers.length) return { status: "error", message: "Duty Register position headers were not found." };

  const lineup = getPositionLineupSnapshot_(ss);
  const date = normalizeDateStr(params && params.date) || lineup.date || Utilities.formatDate(new Date(), "Asia/Kolkata", "yyyy-MM-dd");
  const row = findDutyRegisterRow_(sheet, date);
  if (row < 0) return { status: "error", message: "No Duty Register row exists for " + formatDisplayDate(date) + "." };

  const offDaySheet = getSheetFuzzy(ss, "Off Day Master");
  let operators = [];
  if (offDaySheet && offDaySheet.getLastRow() >= 2) {
    operators = offDaySheet.getRange(2, 1, offDaySheet.getLastRow() - 1, 1).getDisplayValues()
      .map(r => String(r[0] || "").trim())
      .filter(v => v && !["l", "a"].includes(v.toLowerCase()));
  }
  ["OT", "H", "M"].forEach(marker => { if (!operators.some(v => v.toLowerCase() === marker.toLowerCase())) operators.push(marker); });
  operators = operators.filter((v, i, a) => a.findIndex(x => x.toLowerCase() === v.toLowerCase()) === i);

  const rawValues = sheet.getRange(row, 3, 1, headers.length).getDisplayValues()[0].map(v => String(v || "").trim());
  const dateInfo = getDutyRegisterDateInfo_(ss, date, sheet.getRange(row, 2).getDisplayValue());
  const lineupItems = lineup.date === date ? lineup.items : [];
  const suggestions = mapDutyLineupSuggestions_(headers, lineupItems);
  const entries = headers.map((position, i) => ({
    position: position,
    value: rawValues[i] || suggestions[i] || "",
    savedValue: rawValues[i],
    suggested: !rawValues[i] && !!suggestions[i]
  }));

  const historicalLineup = getHistoricalLineupForDate_(ss, headers, date, row, suggestions);
  return {
    status: "success", date: date, dateText: formatDisplayDate(date), day: dateInfo.day, shift: dateInfo.shift,
    rowNumber: row, positions: headers, operators: operators, entries: entries,
    lineup: historicalLineup,
    lineupDate: lineup.date, lineupDateText: lineup.date ? formatDisplayDate(lineup.date) : ""
  };
}

function validateDutyRegisterEntries_(entries, headers, allowed, existingValues) {
  if (!Array.isArray(entries)) return "Invalid duty entries.";
  const byPosition = {};
  entries.forEach(item => {
    const key = String(item && item.position || "").trim().toLowerCase();
    if (key) byPosition[key] = String(item.value || "").trim();
  });
  const values = headers.map(h => byPosition[String(h || "").trim().toLowerCase()] || "");
  const allowedSet = new Set(allowed.map(x => String(x).trim().toLowerCase()));
  const seen = new Set();
  for (let i = 0; i < values.length; i++) {
    const value = values[i];
    if (!value) continue;
    const priorValue = String(existingValues && existingValues[String(headers[i] || "").trim().toLowerCase()] || "").trim();
    if (!allowedSet.has(value.toLowerCase()) && value.toLowerCase() !== priorValue.toLowerCase()) return "Choose an operator or OT, H, or M from the list for " + headers[i] + ".";
    if (["ot", "h", "m", "l", "a"].includes(value.toLowerCase())) continue;
    const key = value.toLowerCase();
    if (seen.has(key)) return "Duplicate operator name: " + value + ". An operator can be assigned to only one position.";
    seen.add(key);
  }
  return { values: values };
}

function saveAdminDutyRegister_(ss, params) {
  const authError = validateAdminDutyRequest_(ss, params);
  if (authError) return authError;
  const date = normalizeDateStr(params && params.date);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return { status: "error", message: "Select a valid duty date." };
  const sheet = getDutyRegisterSheet_(ss);
  if (!sheet) return { status: "error", message: "Duty Register sheet not found." };
  const headers = getDutyRegisterHeaders_(sheet);
  const offDaySheet = getSheetFuzzy(ss, "Off Day Master");
  let allowed = offDaySheet && offDaySheet.getLastRow() >= 2
    ? offDaySheet.getRange(2, 1, offDaySheet.getLastRow() - 1, 1).getDisplayValues().map(r => String(r[0] || "").trim()).filter(v => v && !["l", "a"].includes(v.toLowerCase()))
    : [];
  allowed = allowed.concat(["OT", "H", "M"]).filter((v, i, a) => a.findIndex(x => x.toLowerCase() === v.toLowerCase()) === i);
  const row = findDutyRegisterRow_(sheet, date);
  if (row < 0) return { status: "error", message: "No Duty Register row exists for " + formatDisplayDate(date) + "." };
  const currentValues = sheet.getRange(row, 3, 1, headers.length).getDisplayValues()[0].map(v => String(v || "").trim());
  const existingByPosition = {};
  headers.forEach((h, i) => { existingByPosition[String(h || "").trim().toLowerCase()] = currentValues[i]; });
  let entries;
  const rawEntries = String(params.entries || "");
  try { entries = JSON.parse(rawEntries); }
  catch (e) {
    try { entries = JSON.parse(decodeURIComponent(rawEntries)); }
    catch (e2) { return { status: "error", message: "Could not read the submitted duty entries." }; }
  }
  const checked = validateDutyRegisterEntries_(entries, headers, allowed, existingByPosition);
  if (typeof checked === "string") return { status: "error", message: checked };

  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return { status: "error", message: "Another duty update is in progress. Please try again." };
  try {
    sheet.getRange(row, 3, 1, headers.length).setValues([checked.values]);
    try { CacheService.getScriptCache().remove("r3_dashboard_cache"); } catch (e) {}
  } finally { lock.releaseLock(); }

  return { status: "success", message: "Duty Register saved successfully.", date: date, dateText: formatDisplayDate(date), day: sheet.getRange(row, 2).getDisplayValue(), rowNumber: row, entries: headers.map((position, i) => ({ position: position, value: checked.values[i] })) };
}

function adminSubmitDutyRegister_(ss, params) {
