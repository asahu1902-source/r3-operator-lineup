function doGet(e) {
  const callback = e ? e.parameter.callback : null;
  const action = e && e.parameter.action ? e.parameter.action : "getDashboardData";
  let output = {};

  if (action === "maintenancePhotoUploader") {
    return createMaintenancePhotoUploaderPage_(e.parameter || {});
  }

  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();

    if (action === "getDashboardData") {
      if (!maintenanceAccessAllowed_(ss, e.parameter)) {
        output = getMaintenanceBlockResponse_(ss);
      } else {
        output = fetchCompleteDashboard(ss);
      }
    } else if (action === "getMaintenanceStatus") {
      output = getMaintenanceStatus_(ss, e.parameter);
    } else if (action === "getAdminMaintenancePhoto") {
      output = getAdminMaintenancePhoto_(ss, e.parameter);
    } else if (action === "setAdminMaintenanceMode") {
      output = setAdminMaintenanceMode_(ss, e.parameter);
    } else if (action === "setAdminMaintenanceSetting") {
      output = setAdminMaintenanceSetting_(ss, e.parameter);
    } else if (action === "verifyAshokPin") {
      output = verifyAshokPin_(ss, e.parameter);
    } else if (action === "checkAshokSession") {
      output = checkAshokSession_(ss, e.parameter);
    } else if (action === "getLatestDuty") {
      if (!maintenanceAccessAllowed_(ss, e.parameter)) {
        output = getMaintenanceBlockResponse_(ss);
      } else {
        output = getLatestDuty_(ss);
      }
    } else if (action === "submitLeave") {
      output = handleLeaveSubmission(ss, e.parameter);
    } else if (action === "getOperatorLeaves") {
      output = fetchOperatorLeaves(ss, e.parameter.name);
    } else if (action === "getLeaveBalance") {
      output = fetchOperatorLeaveBalance(ss, e.parameter.name);
    } else if (action === "withdrawLeave") {
      output = handleWithdrawLeave(ss, e.parameter.rowIndex);
    } else if (action === "getMonthlyReport") {
      output = fetchMonthlyReport(ss, e.parameter);
    } else if (action === "getChat") {
      output = fetchGroupChat(ss);
    } else if (action === "sendChat") {
      output = handleChatSubmission(ss, e.parameter);
    } else if (action === "updatePresence") {
      output = updateOperatorPresence(ss, e.parameter);
    } else if (action === "submitMyDuty") {
      output = handleDutySubmission(ss, e.parameter);
    } else if (action === "getDutyStatus") {
      output = fetchDutyStatusSummary(ss, { usePublishedSnapshot: true });
    } else if (action === "adminSubmitDuty") {
      output = handleAdminDutySubmission_(ss, e.parameter);
    } else if (action === "getDutyByDate") {
      output = getDutyByDate(ss, e.parameter.date);
    } else if (action === "getAdminDutyRegister") {
      output = getAdminDutyRegister_(ss, e.parameter);
    } else if (action === "saveAdminDutyRegister") {
      output = saveAdminDutyRegister_(ss, e.parameter);
    } else if (action === "adminSubmitDutyRegister") {
      output = adminSubmitDutyRegister_(ss, e.parameter);
    } else if (action === "getAutoDutyConfig") {
      output = getAutoDutyConfig_(ss, e.parameter);
    } else if (action === "saveAutoDutyConfig") {
      output = saveAutoDutyConfig_(ss, e.parameter);
    } else if (action === "resetAutoDutyTestState") {
      output = resetAutoDutyTestState_(ss, e.parameter);
    } else if (action === "getAutoDutyOperatorState") {
      output = getAutoDutyOperatorState_(ss);
    } else if (action === "sendOperatorMessage") {
      output = handleOperatorMessageSubmission(ss, e.parameter);
    } else if (action === "getOperatorMessages") {
      output = fetchOperatorMessages(ss);
    }
  } catch (err) {
    output = { status: "error", message: err.toString() };
  }

  const jsonString = JSON.stringify(output);
  if (callback) {
    return ContentService.createTextOutput(callback + "(" + jsonString + ");")
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  return ContentService.createTextOutput(jsonString)
    .setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  const params = e && e.parameter ? e.parameter : {};
  let output;
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    if (String(params.action || "") === "saveMaintenancePhoto") {
      output = saveMaintenancePhoto_(ss, params);
    } else {
      output = { status: "error", message: "Unknown maintenance action." };
    }
  } catch (err) {
    output = { status: "error", message: String(err && err.message || err) };
  }
  const message = JSON.stringify({
    type: "r3-maintenance-photo-result",
    requestId: String(params.requestId || ""),
    result: output
  }).replace(/</g, "\\u003c");
  return HtmlService.createHtmlOutput('<!doctype html><meta charset="utf-8"><script>parent.postMessage(' + message + ',"*");</script>')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

