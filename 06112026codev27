// ============================================================
// MAINTENANCE MODE + ASHOK AUTHENTICATION
// ============================================================
// Maintenance_Mode sheet:
// A2 = Maintenance Mode    | B2 = ON / OFF
// A3 = Maintenance Message | B3 = message
// A4 = Allowed User        | B4 = Ashok
//
// Ashok's PIN is NOT stored in the sheet or in the source code.
// setupAshokPin() lets the admin choose a 6-digit PIN and stores only a
// salted SHA-256 hash in Script Properties. The plain PIN is never stored
// in the sheet, execution log, or source code.

const R3_MAINT_SHEET = "Maintenance_Mode";
const R3_ASHOK_PIN_HASH_KEY = "R3_ASHOK_PIN_HASH";
const R3_ASHOK_PIN_SALT_KEY = "R3_ASHOK_PIN_SALT";
const R3_ASHOK_AUTH_PREFIX = "r3_ashok_auth_";
const R3_ASHOK_AUTH_TTL = 21600; // 6 hours
const R3_MAINTENANCE_IMAGE_ID_KEY = "R3_MAINTENANCE_IMAGE_FILE_ID";
const R3_MAINTENANCE_PHOTO_PUBLISHED_KEY = "R3_MAINTENANCE_PHOTO_PUBLISHED";

function getMaintenancePhotoUrl_() {
  const id = PropertiesService.getScriptProperties().getProperty(R3_MAINTENANCE_IMAGE_ID_KEY) || "";
  return id ? "https://drive.google.com/thumbnail?id=" + encodeURIComponent(id) + "&sz=w1600" : "";
}

function authorizeMaintenancePhotoStorage() {
  DriveApp.getRootFolder().getId();
  return "Maintenance photo storage is authorized.";
}

function getAdminMaintenancePhoto_(ss, params) {
  const authError = validateAdminDutyRequest_(ss, params);
  if (authError) return authError;
  const fileId = PropertiesService.getScriptProperties().getProperty(R3_MAINTENANCE_IMAGE_ID_KEY) || "";
  let fileName = "";
  if (fileId) {
    try { fileName = DriveApp.getFileById(fileId).getName(); } catch (e) {}
  }
  const cfg = readMaintenanceConfig_(ss);
  return {
    status: "success",
    maintenanceMode: cfg.enabled,
    showMaintenanceLineup: cfg.showMaintenanceLineup,
    maintenanceMessage: cfg.message,
    photoPublished: cfg.photoPublished,
    imageUrl: getMaintenancePhotoUrl_(),
    fileName: fileName
  };
}

function setAdminMaintenanceSetting_(ss, params) {
  const authError = validateAdminDutyRequest_(ss, params);
  if (authError) return authError;
  const setting = String(params && params.setting || "").trim();
  const value = String(params && params.value || "").trim();
  const sheet = getSheetFuzzy(ss, R3_MAINT_SHEET);
  if (!sheet) return { status: "error", message: "Maintenance_Mode sheet was not found." };
  const props = PropertiesService.getScriptProperties();
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return { status: "error", message: "Another update is running. Please try again." };
  try {
    if (setting === "maintenanceMode" || setting === "showMaintenanceLineup") {
      const mode = value.toUpperCase();
      if (mode !== "ON" && mode !== "OFF") return { status: "error", message: "Choose ON or OFF." };
      sheet.getRange(setting === "maintenanceMode" ? "B2" : "B5").setValue(mode);
    } else if (setting === "maintenanceMessage") {
      if (!value) return { status: "error", message: "Enter a maintenance message." };
      if (value.length > 240) return { status: "error", message: "Maintenance message must be 240 characters or less." };
      sheet.getRange("B3").setValue(value);
    } else if (setting === "photoPublished") {
      const mode = value.toUpperCase();
      if (mode !== "ON" && mode !== "OFF") return { status: "error", message: "Choose Photo Publish ON or OFF." };
      if (mode === "ON" && !props.getProperty(R3_MAINTENANCE_IMAGE_ID_KEY)) {
        return { status: "error", message: "Upload a photo before turning Photo Publish ON." };
      }
      props.setProperty(R3_MAINTENANCE_PHOTO_PUBLISHED_KEY, mode);
    } else {
      return { status: "error", message: "Unknown Maintenance Mode setting." };
    }
    SpreadsheetApp.flush();
    try { CacheService.getScriptCache().remove("r3_dashboard_cache"); } catch (e) {}
    const cfg = readMaintenanceConfig_(ss);
    return {
      status: "success",
      maintenanceMode: cfg.enabled,
      maintenanceMessage: cfg.message,
      showMaintenanceLineup: cfg.showMaintenanceLineup,
      photoPublished: cfg.photoPublished,
      message: "Maintenance settings saved."
    };
  } finally {
    lock.releaseLock();
  }
}

function setAdminMaintenanceMode_(ss, params) {
  const authError = validateAdminDutyRequest_(ss, params);
  if (authError) return authError;
  const mode = String(params && params.mode || "").trim().toUpperCase();
  if (mode !== "ON" && mode !== "OFF") {
    return { status: "error", message: "Choose Maintenance Mode ON or OFF." };
  }
  const sheet = getSheetFuzzy(ss, R3_MAINT_SHEET);
  if (!sheet) return { status: "error", message: "Maintenance_Mode sheet was not found." };
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) return { status: "error", message: "Another update is running. Please try again." };
  try {
    sheet.getRange("B2").setValue(mode);
    SpreadsheetApp.flush();
    try { CacheService.getScriptCache().remove("r3_dashboard_cache"); } catch (e) {}
    return { status: "success", maintenanceMode: mode === "ON", message: "Maintenance Mode is now " + mode + "." };
  } finally {
    lock.releaseLock();
  }
}

function saveMaintenancePhoto_(ss, params) {
  const authError = validateAdminDutyRequest_(ss, params);
  if (authError) return authError;
  const base64 = String(params.imageData || "").trim();
  const mimeType = String(params.mimeType || "").trim().toLowerCase();
  const fileName = String(params.fileName || "maintenance-photo.jpg").replace(/[\\/:*?"<>|]/g, "_").slice(0, 100);
  if (!base64) return { status: "error", message: "Choose a photo first." };
  if (mimeType !== "image/jpeg") return { status: "error", message: "Photo must be compressed to JPEG before upload." };
  if (base64.length > 2800000) return { status: "error", message: "Photo is too large. Choose a smaller image and try again." };

  const bytes = Utilities.base64Decode(base64);
  if (bytes.length > 2000000) return { status: "error", message: "Photo must be smaller than 2 MB after compression." };
  const blob = Utilities.newBlob(bytes, mimeType, fileName || "maintenance-photo.jpg");
  const file = DriveApp.createFile(blob);
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  PropertiesService.getScriptProperties().setProperty(R3_MAINTENANCE_IMAGE_ID_KEY, file.getId());
  return {
    status: "success",
    imageUrl: "https://drive.google.com/thumbnail?id=" + encodeURIComponent(file.getId()) + "&sz=w1600",
    fileName: file.getName()
  };
}

function readMaintenanceConfig_(ss) {
  const sheet = getSheetFuzzy(ss, R3_MAINT_SHEET);
  if (!sheet) {
    return {
      enabled: false,
      message: "App is under Maintenance",
      allowedUser: "Ashok",
      showMaintenanceLineup: false,
      maintenanceLineupDate: "",
      maintenanceImageUrl: getMaintenancePhotoUrl_(),
      photoPublished: PropertiesService.getScriptProperties().getProperty(R3_MAINTENANCE_PHOTO_PUBLISHED_KEY) === "ON"
    };
  }

  const mode = (sheet.getRange("B2").getDisplayValue() || "OFF").trim().toUpperCase();
  const message = (sheet.getRange("B3").getDisplayValue() || "App is under Maintenance").trim();
  const allowedUser = (sheet.getRange("B4").getDisplayValue() || "Ashok").trim() || "Ashok";
  const showLineup = (sheet.getRange("B5").getDisplayValue() || "OFF").trim().toUpperCase() === "ON";
  const lineupDate = sheet.getRange("B6").getValue();

  return {
    enabled: mode === "ON",
    message: message || "App is under Maintenance",
    allowedUser: allowedUser,
    showMaintenanceLineup: showLineup,
    maintenanceLineupDate: lineupDate,
    maintenanceImageUrl: getMaintenancePhotoUrl_(),
    photoPublished: PropertiesService.getScriptProperties().getProperty(R3_MAINTENANCE_PHOTO_PUBLISHED_KEY) === "ON"
  };
}

function getMaintenanceStatus_(ss, params) {
  const cfg = readMaintenanceConfig_(ss);
  const requestedName = (params && params.name ? params.name : "").trim();
  const lineup = (cfg.enabled && cfg.showMaintenanceLineup)
    ? getMaintenanceDayLineup_(ss, cfg.maintenanceLineupDate)
    : null;

  return {
    status: "success",
    maintenanceMode: cfg.enabled,
    message: cfg.message,
    allowedUser: cfg.allowedUser,
    showMaintenanceLineup: cfg.showMaintenanceLineup,
    maintenanceLineupDate: formatMaintenanceDate_(cfg.maintenanceLineupDate),
    maintenanceImageUrl: cfg.photoPublished ? cfg.maintenanceImageUrl : "",
    photoPublished: cfg.photoPublished,
    maintenanceLineup: lineup,
    requestedUserIsAllowed: requestedName && requestedName.toLowerCase() === cfg.allowedUser.toLowerCase()
  };
}

function formatMaintenanceDate_(value) {
  if (!value) return "";
  if (Object.prototype.toString.call(value) === "[object Date]" && !isNaN(value.getTime())) {
    return Utilities.formatDate(value, Session.getScriptTimeZone(), "dd/MM/yyyy");
  }
  return String(value);
}

function getMaintenanceDayLineup_(ss, configuredDate) {
  const sheet = getSheetFuzzy(ss, "Maintenance Day_Lineup");
  if (!sheet) {
    return { title: "TODAY'S DUTY LINE-UP", displayDate: formatMaintenanceDate_(configuredDate), headers: [], rows: [] };
  }

  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();
  if (lastRow < 1 || lastCol < 1) {
    return { title: "TODAY'S DUTY LINE-UP", displayDate: formatMaintenanceDate_(configuredDate), headers: [], rows: [] };
  }

  const values = sheet.getRange(1, 1, lastRow, lastCol).getDisplayValues();
  let headerRow = -1;
  let headerStart = -1;

  for (let r = 0; r < values.length; r++) {
    let posCol = -1;
    let recCol = -1;
    for (let c = 0; c < values[r].length; c++) {
      const v = String(values[r][c] || "").trim().toLowerCase();
      if (v === "position") posCol = c;
      if (v === "recommended" || v === "recommended operator" || v === "operator") recCol = c;
    }
    if (posCol >= 0 && recCol >= 0) {
      headerRow = r;
      headerStart = Math.min(posCol, recCol);
      break;
    }
  }

  if (headerRow < 0) {
    return { title: "TODAY'S DUTY LINE-UP", displayDate: formatMaintenanceDate_(configuredDate), headers: [], rows: [] };
  }

  const rawHeaders = values[headerRow].slice(headerStart);
  let headerCount = rawHeaders.length;
  while (headerCount > 0 && !String(rawHeaders[headerCount - 1] || "").trim()) headerCount--;
  const headers = rawHeaders.slice(0, headerCount);

  const rows = [];
  let blankStreak = 0;
  for (let r = headerRow + 1; r < values.length && rows.length < 60; r++) {
    const row = values[r].slice(headerStart, headerStart + headers.length);
    const hasAny = row.some(v => String(v || "").trim() !== "");
    if (!hasAny) {
      blankStreak++;
      if (blankStreak >= 2) break;
      continue;
    }
    blankStreak = 0;
    rows.push(row);
  }

  // Try to read a title/date from the rows above the table.
  let title = "TODAY'S DUTY LINE-UP";
  for (let r = 0; r < headerRow; r++) {
    const text = values[r].filter(v => String(v || "").trim()).join(" ").trim();
    if (text) {
      if (/distribution\s+list/i.test(text)) title = "DUTY LINE-UP";
    }
  }

  return {
    title: title,
    displayDate: formatMaintenanceDate_(configuredDate),
    headers: headers,
    rows: rows
  };
}

function bytesToHex_(bytes) {
  return bytes.map(function(b) {
    const v = (b < 0 ? b + 256 : b).toString(16);
    return v.length === 1 ? "0" + v : v;
  }).join("");
}

function hashAshokPin_(pin, salt) {
  const raw = String(salt || "") + ":" + String(pin || "");
  const digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, raw, Utilities.Charset.UTF_8);
  return bytesToHex_(digest);
}

function generateSecurePin_() {
  // Generate a cryptographically random 6-digit PIN from UUID entropy.
  const uuid = Utilities.getUuid().replace(/-/g, "");
  let num = parseInt(uuid.substring(0, 8), 16) % 1000000;
  if (num < 0) num = Math.abs(num);
  return String(num).padStart(6, "0");
}

function setupAshokPin() {
  const ui = SpreadsheetApp.getUi();
  const response = ui.prompt(
    "Set Ashok PIN",
    "Enter your 6-digit PIN:",
    ui.ButtonSet.OK_CANCEL
  );

  if (response.getSelectedButton() !== ui.Button.OK) {
    return { status: "cancelled", message: "PIN setup cancelled." };
  }

  const pin = response.getResponseText().trim();

  if (!/^\d{6}$/.test(pin)) {
    ui.alert("Invalid PIN", "Please enter exactly 6 digits.", ui.ButtonSet.OK);
    return { status: "error", message: "PIN must be exactly 6 digits." };
  }

  const props = PropertiesService.getScriptProperties();
  const salt = Utilities.getUuid();
  const hash = hashAshokPin_(pin, salt);

  props.setProperty(R3_ASHOK_PIN_SALT_KEY, salt);
  props.setProperty(R3_ASHOK_PIN_HASH_KEY, hash);

  ui.alert(
    "Success",
    "Ashok PIN has been saved securely.\n\nThe PIN is not stored in the sheet or source code.",
    ui.ButtonSet.OK
  );

  return { status: "success", message: "Ashok PIN saved successfully." };
}

function verifyAshokPin_(ss, params) {
  const cfg = readMaintenanceConfig_(ss);
  const name = (params && params.name ? params.name : "").trim();
  const pin = (params && params.pin ? params.pin : "").trim();

  if (!name || name.toLowerCase() !== cfg.allowedUser.toLowerCase()) {
    return { status: "error", authenticated: false, message: "Ashok authentication required." };
  }
  if (!/^\d{6}$/.test(pin)) {
    return { status: "error", authenticated: false, message: "Please enter the 6-digit PIN." };
  }

  const props = PropertiesService.getScriptProperties();
  const salt = props.getProperty(R3_ASHOK_PIN_SALT_KEY) || "";
  const storedHash = props.getProperty(R3_ASHOK_PIN_HASH_KEY) || "";

  if (!salt || !storedHash) {
    return { status: "error", authenticated: false, message: "Ashok PIN is not configured yet. Run setupAshokPin() once." };
  }

  const suppliedHash = hashAshokPin_(pin, salt);
  if (suppliedHash !== storedHash) {
    return { status: "error", authenticated: false, message: "Incorrect Ashok PIN." };
  }

  const token = Utilities.getUuid().replace(/-/g, "") + Utilities.getUuid().replace(/-/g, "");
  CacheService.getScriptCache().put(R3_ASHOK_AUTH_PREFIX + token, cfg.allowedUser, R3_ASHOK_AUTH_TTL);

  return {
    status: "success",
    authenticated: true,
    token: token,
    user: cfg.allowedUser
  };
}

function isValidAshokToken_(name, token, allowedUser) {
  if (!name || !token) return false;
  if (name.toLowerCase() !== allowedUser.toLowerCase()) return false;
  const cachedUser = CacheService.getScriptCache().get(R3_ASHOK_AUTH_PREFIX + token);
  return !!cachedUser && cachedUser.toLowerCase() === allowedUser.toLowerCase();
}

